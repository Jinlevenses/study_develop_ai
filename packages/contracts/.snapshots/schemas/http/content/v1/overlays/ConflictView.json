{
  "type": "object",
  "properties": {
    "conflict_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "patch_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "target_kind": {
      "type": "string",
      "enum": ["concept", "ku", "misconception", "item", "case", "source"]
    },
    "target_id": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "base_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_base_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pack_value": {
      "$ref": "#/$defs/__schema0"
    },
    "overlay_value": {
      "$ref": "#/$defs/__schema1"
    },
    "state": {
      "type": "string",
      "enum": ["open", "resolved"]
    },
    "resolution": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["keep_overlay", "take_pack", "edit"]
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    }
  },
  "required": [
    "conflict_id",
    "patch_id",
    "target_kind",
    "target_id",
    "field",
    "base_version",
    "new_base_version",
    "pack_value",
    "overlay_value",
    "state",
    "resolution",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
