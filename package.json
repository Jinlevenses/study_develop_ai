{
  "name": "fathom-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source apps/cli/src/main.ts up --profile=dev --foreground",
    "fathom": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source apps/cli/src/main.ts",
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci",
    "test": "turbo run test",
    "test:contract": "node --conditions=source node_modules/vitest/vitest.mjs run --config tests/vitest.config.ts --project contract --configLoader native",
    "test:chaos": "node --conditions=source node_modules/vitest/vitest.mjs run --config tests/vitest.config.ts --project chaos --configLoader native",
    "test:integration": "turbo run test:integration && node --conditions=source node_modules/vitest/vitest.mjs run --config tests/vitest.config.ts --project integration --configLoader native",
    "test:security": "turbo run test:security && node --conditions=source node_modules/vitest/vitest.mjs run --config tests/vitest.config.ts --project security --configLoader native",
    "test:e2e": "node --conditions=source node_modules/@playwright/test/cli.js test --config tests/playwright.config.ts",
    "test:perf": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tests/perf/run-all.ts",
    "test:coverage": "turbo run test -- --coverage",
    "test:determinism": "node tests/support/determinism.mjs",
    "test:offline": "node tests/support/run-offline.mjs -- pnpm test:e2e --grep @offline",
    "si:reports": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/si-docs/src/cli.ts reports",
    "contracts:gen": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source packages/contracts/scripts/gen.ts",
    "policy:lock": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/packc/src/policy/lock-cli.ts",
    "content:check": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/packc/src/cli.ts check",
    "content:scaffold": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/packc/src/cli.ts scaffold",
    "content:schemas": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/packc/src/cli.ts schemas",
    "content:fetch-sources": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/packc/src/cli.ts fetch-sources",
    "packs:build": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/packc/src/cli.ts build",
    "ai:lint-prompts": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source services/ai-gateway/eval/cli.ts lint-prompts",
    "ai:eval": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source services/ai-gateway/eval/cli.ts eval",
    "ai:eval:gates": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source services/ai-gateway/eval/cli.ts gates",
    "ai:record": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source services/ai-gateway/eval/cli.ts record",
    "sim": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source services/learning/sim/cli.ts",
    "graph:update": "graphify update .",
    "graph:snapshot": "node --disable-warning=ExperimentalWarning --import tsx --conditions=source tools/graph/src/cli.ts snapshot",
    "audit:graph": "node tools/gates/check-graphify-edges.mjs --root . --extract",
    "check:gates": "node tools/gates/run-gates.mjs",
    "check:boundaries": "node tools/gates/check-boundaries.mjs --engine=both",
    "check:deps": "node tools/gates/check-deps.mjs",
    "check:tsconfig-paths": "node tools/gates/check-tsconfig-paths.mjs",
    "check:gate-selftest": "node tools/gates/check-gate-selftest.mjs",
    "check:scope": "node tools/gates/check-scope.mjs",
    "check:sql-typed": "node tools/gates/check-sql-typed.mjs",
    "check:db-paths": "node tools/gates/check-db-paths.mjs",
    "check:ledger-writer": "node tools/gates/check-ledger-writer.mjs",
    "check:content-ingest": "node tools/gates/check-content-ingest.mjs",
    "check:jev-index": "node tools/gates/check-jev-index.mjs",
    "check:ng-g": "node tools/gates/check-ng-g.mjs",
    "check:typo-ko": "node tools/gates/check-typo-ko.mjs",
    "check:frozen": "node tools/gates/check-frozen.mjs",
    "check:consumers": "node tools/gates/check-consumers.mjs",
    "check:manifest": "node tools/gates/check-manifest.mjs",
    "check:rtm": "node tools/gates/check-rtm.mjs",
    "check:security": "node tools/gates/check-security-scan.mjs",
    "check:sql": "node tools/gates/check-sql-template.mjs",
    "lint:hooks": "node tools/gates/check-hooks.mjs",
    "bundle": "echo skipped"
  },
  "devDependencies": {
    "@fathom/contracts": "workspace:*",
    "@fathom/testkit": "workspace:*",
    "typescript": "7.0.2",
    "turbo": "2.11.5",
    "@biomejs/biome": "2.5.14",
    "tsx": "4.23.15",
    "@types/node": "22.20.4",
    "vitest": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "vite": "8.3.1",
    "@playwright/test": "1.56.1",
    "playwright-core": "1.56.1",
    "@axe-core/playwright": "4.13.0",
    "autocannon": "8.0.0"
  }
}
