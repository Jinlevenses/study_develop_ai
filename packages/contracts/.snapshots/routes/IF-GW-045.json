{
  "$comment": "gateway.concepts.sources",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.concepts.sources"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/api/v1/concepts/{concept_id}/sources"
    },
    "allowedCallers": {
      "enum": [
        "browser"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "FR-CUR-012",
        "FR-CUR-021"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "concept_id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
            }
          },
          "required": [
            "concept_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "concept_id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
            },
            "sources": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "grade": {
                    "type": "string",
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D",
                      "P"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "edition": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 60
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "license": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "retrieved_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "source_id",
                  "title",
                  "grade",
                  "url",
                  "edition",
                  "license",
                  "retrieved_at"
                ],
                "additionalProperties": false
              }
            },
            "ku_spans": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ku_id": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
                  },
                  "source_id": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                  },
                  "locator": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "quote_ko": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "ku_id",
                  "source_id",
                  "locator",
                  "quote_ko"
                ],
                "additionalProperties": false
              }
            },
            "disagreements": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ku_id": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
                  },
                  "note_md": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "ku_id",
                  "note_md"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "concept_id",
            "sources",
            "ku_spans",
            "disagreements"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
