{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "number",
      "const": 1
    },
    "wp": {
      "type": "string",
      "pattern": "^WP-[A-Za-z0-9.-]{2,40}$"
    },
    "requests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["web", "doc", "book", "rfc", "paper", "repo", "user"]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "publisher": {
            "type": "string",
            "maxLength": 80
          },
          "base_url": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^https:\\/\\/.*"
          },
          "repo": {
            "type": "string",
            "pattern": "^github\\.com\\/[\\w.-]+\\/[\\w.-]+$"
          },
          "ref_text": {
            "type": "string",
            "maxLength": 200
          },
          "license": {
            "type": "object",
            "properties": {
              "spdx": {
                "type": "string",
                "maxLength": 40
              },
              "grade": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "P"]
              },
              "verified_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "evidence": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": ["spdx", "grade", "verified_at", "evidence"],
            "additionalProperties": false
          },
          "code_license": {
            "type": "object",
            "properties": {
              "spdx": {
                "type": "string",
                "maxLength": 40
              },
              "grade": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "P"]
              }
            },
            "required": ["spdx", "grade"],
            "additionalProperties": false
          },
          "attribution_template": {
            "type": "string",
            "maxLength": 200
          },
          "allowed_usage": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["link_only", "paraphrase", "short_quote", "code_adapted"]
            }
          },
          "primary": {
            "default": false,
            "type": "boolean"
          },
          "fetch": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": ["git_sparse", "none"]
              },
              "path_glob": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": ["method"],
            "additionalProperties": false
          },
          "versioned_by": {
            "default": "none",
            "type": "string",
            "enum": ["product_version", "edition", "none"]
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "merged": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "title",
          "publisher",
          "license",
          "attribution_template",
          "allowed_usage",
          "fetch",
          "reason",
          "merged"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_v", "wp", "requests"],
  "additionalProperties": false
}
