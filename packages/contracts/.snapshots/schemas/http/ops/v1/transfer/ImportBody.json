{
  "type": "object",
  "properties": {
    "op_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "mode": {
      "type": "string",
      "const": "merge"
    }
  },
  "required": ["op_id", "path", "mode"],
  "additionalProperties": false
}
