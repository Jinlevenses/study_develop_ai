{
  "type": "object",
  "properties": {
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "scenario_kind": {
      "type": "string",
      "enum": ["incident", "tradeoff", "design"]
    },
    "target_ku_ids": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
      }
    }
  },
  "required": ["track", "level", "scenario_kind", "target_ku_ids"],
  "additionalProperties": false
}
