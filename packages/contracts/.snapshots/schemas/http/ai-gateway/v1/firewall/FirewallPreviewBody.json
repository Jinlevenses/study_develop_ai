{
  "type": "object",
  "properties": {
    "blocks": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "text": {
            "type": "string",
            "maxLength": 200000
          },
          "data_class": {
            "type": "string",
            "enum": ["C0", "C1", "C2", "C3"]
          },
          "untrusted": {
            "type": "boolean"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["key", "text", "data_class", "untrusted", "source_ref"],
        "additionalProperties": false
      }
    },
    "route": {
      "type": "string",
      "enum": ["external", "local_only"]
    }
  },
  "required": ["blocks", "route"],
  "additionalProperties": false
}
