            "alg",
            "cs",
            "net",
            "lang",
            "fe",
            "be",
            "db",
            "linux",
            "docker",
            "k8s",
            "cicd",
            "sre",
            "cloud",
            "sec",
            "ml",
            "llm",
            "arch",
            "eng",
            "lead",
            "data"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "local_only": {
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "source",
    "target_track",
    "local_only"
