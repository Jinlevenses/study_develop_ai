{
  "name": "@fathom/shared-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source node_modules/vitest/vitest.mjs run --project unit --configLoader native",
    "test:integration": "node --conditions=source node_modules/vitest/vitest.mjs run --project integration --configLoader native",
    "test:security": "node --conditions=source node_modules/vitest/vitest.mjs run --project security --configLoader native",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fathom/contracts": "workspace:*",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "ulidx": "2.4.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fathom/testkit": "workspace:*",
    "@types/node": "22.20.4",
    "pino-pretty": "13.1.3",
    "vitest": "5.0.2"
  }
}
