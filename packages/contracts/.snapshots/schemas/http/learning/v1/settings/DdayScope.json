{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "concepts"
        },
        "concept_ids": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
          }
        }
      },
      "required": ["kind", "concept_ids"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tag"
        },
        "tag": {
          "type": "string",
          "pattern": "^cert:[a-z0-9-]{2,40}$"
        }
      },
      "required": ["kind", "tag"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "blueprint"
        },
        "blueprint_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:cert-[a-z0-9]+(?:-[a-z0-9]+)*@\\d{4})$"
        }
      },
      "required": ["kind", "blueprint_id"],
      "additionalProperties": false
    }
  ]
}
