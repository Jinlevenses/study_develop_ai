{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "engine": {
          "type": "string",
          "enum": ["J", "LJ"]
        },
        "calibrated": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "answers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "noul"
                  },
                  "p_yes": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["type", "p_yes"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "choice"
                  },
                  "choice": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "probabilities": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{1,31}$"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "required": ["type", "choice", "confidence", "probabilities"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "score"
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "probabilities": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^\\d{1,2}$"
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "levels": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 10
                  }
                },
                "required": ["type", "score", "confidence", "probabilities", "levels"],
                "additionalProperties": false
              }
            ]
          }
        },
        "model_version": {
          "type": "string",
          "maxLength": 80
        },
        "provider_id": {
          "type": "string",
          "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
        },
        "prompt_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "judge_log_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "firewall_decision_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "cache_hit": {
          "type": "boolean"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "engine",
        "calibrated",
        "confidence",
        "answers",
        "model_version",
        "provider_id",
        "prompt_version",
        "judge_log_id",
        "firewall_decision_id",
        "cache_hit",
        "latency_ms"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "enum": [
            "offline",
            "no_consented_provider",
            "auth_invalid",
            "breaker_open",
            "deadline",
            "firewall_blocked",
            "budget_exhausted",
            "quota_exhausted",
            "task_disabled",
            "provider_error",
            "bad_request",
            "calibrated_engine_unavailable",
            "busy"
          ]
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["status", "reason", "retry_after_ms"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "deferred"
        },
        "reason": {
          "type": "string",
          "enum": ["background_queued", "batch_window_closed", "work_order_pending"]
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["status", "reason", "job_id"],
      "additionalProperties": false
    }
  ]
}
