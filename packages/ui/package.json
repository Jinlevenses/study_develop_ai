{
  "name": "@fathom/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": {
      "source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./badges/*": {
      "source": "./src/badges/*.tsx",
      "types": "./dist/badges/*.d.ts",
      "default": "./dist/badges/*.js"
    },
    "./hooks/*": {
      "source": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source node_modules/vitest/vitest.mjs run --project unit --configLoader native",
    "test:integration": "node --conditions=source node_modules/vitest/vitest.mjs run --project integration --configLoader native",
    "test:security": "node --conditions=source node_modules/vitest/vitest.mjs run --project security --configLoader native",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fathom/design-tokens": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@fathom/testkit": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "vitest": "5.0.2"
  }
}
