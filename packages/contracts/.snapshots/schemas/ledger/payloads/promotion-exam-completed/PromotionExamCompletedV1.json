{
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "item_ids": {
      "minItems": 12,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 140,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
      }
    },
    "formats": {
      "minItems": 4,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "embedded",
          "ox",
          "mcq",
          "cloze",
          "short",
          "matching",
          "code_task",
          "blank_note",
          "digging_d4_mcq",
          "error_find",
          "confusable",
          "fermi",
          "cond_reversal",
          "infra_lite",
          "kata",
          "audit",
          "case_decision",
          "code_predict",
          "sql_task",
          "essay",
          "digging",
          "feynman",
          "pr_review",
          "reverse_item",
          "artifact",
          "case_postmortem",
          "micro_judgment",
          "ml_predict",
          "mcq_multi",
          "order",
          "parsons",
          "log_read",
          "config_review"
        ]
      }
    },
    "correct_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "cbm_ratio": {
      "type": "number"
    },
    "passed": {
      "type": "boolean"
    },
    "profile": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^ps_[0-9a-f]{16}$"
        },
        "ai_mode": {
          "type": "string",
          "enum": ["FULL", "JUDGE_ONLY", "LLM_ONLY", "OFFLINE"]
        },
        "sp1_state": {
          "type": "string",
          "enum": ["pass", "fail", "unknown"]
        }
      },
      "required": ["policy_version", "ai_mode", "sp1_state"],
      "additionalProperties": false
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "required": [
    "exam_id",
    "track",
    "level",
    "item_ids",
    "formats",
    "correct_count",
    "cbm_ratio",
    "passed",
    "profile",
    "study_day"
  ],
  "additionalProperties": false
}
