{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "FULL",
        "JUDGE_ONLY",
        "LLM_ONLY",
        "OFFLINE"
      ]
    },
    "providers": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "jev",
              "llm_api",
              "llm_cli",
              "generic_cli",
              "local_llm"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down",
              "unconsented",
              "disabled"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "required": [
    "mode",
    "providers",
    "source_event_id",
    "observed_at",
    "study_day"
  ],
  "additionalProperties": false
}
