{
  "type": "object",
  "properties": {
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "from": {
      "type": "string",
      "enum": [
        "unseen",
        "learning",
        "mastered"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "unseen",
        "learning",
        "mastered"
      ]
    },
    "provisional": {
      "type": "boolean"
    }
  },
  "required": [
    "concept_id",
    "from",
    "to",
    "provisional"
  ],
  "additionalProperties": false
}
