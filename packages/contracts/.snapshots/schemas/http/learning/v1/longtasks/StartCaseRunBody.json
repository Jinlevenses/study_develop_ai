{
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "case_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.case\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "block_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "variant_seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["run_id", "case_id", "session_id", "block_id", "variant_seed"],
  "additionalProperties": false
}
