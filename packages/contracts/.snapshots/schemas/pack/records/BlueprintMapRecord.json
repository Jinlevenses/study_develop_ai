{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "blueprint_map"
    },
    "blueprint_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:cert-[a-z0-9]+(?:-[a-z0-9]+)*@\\d{4})$"
    },
    "section_key": {
      "type": "string",
      "pattern": "^s\\d{1,2}(_\\d{1,2})?$"
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "weight": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "kind",
    "blueprint_id",
    "section_key",
    "concept_id",
    "weight"
  ],
  "additionalProperties": false
}
