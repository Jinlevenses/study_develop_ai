{
  "$comment": "ai-gateway.providers.probe",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.providers.probe"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/providers:probe"
    },
    "allowedCallers": {
      "enum": [
        "gateway",
        "ops-api"
      ]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R0"
    },
    "fr": {
      "enum": [
        "FR-AI-001",
        "FR-AI-015"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "probe_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "providers": {
              "anyOf": [
                {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "live": {
              "type": "boolean"
            }
          },
          "required": [
            "probe_id",
            "providers",
            "live"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "202": {
          "type": "object",
          "properties": {
            "probe_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "state": {
              "type": "string",
              "enum": [
                "running",
                "done"
              ]
            },
            "results": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "degraded",
                      "down",
                      "unconsented",
                      "disabled"
                    ]
                  },
                  "probe": {
                    "type": "object",
                    "properties": {
                      "installed": {
                        "type": "boolean"
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 60
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "logged_in": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "flags_ok": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "missing_flags": {
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 60
                        }
                      },
                      "key_present": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "models": {
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 80
                        }
                      },
                      "latency_ms": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "checked_at": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8640000000000000
                      },
                      "reason_code": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 60
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "installed",
                      "version",
                      "logged_in",
                      "flags_ok",
                      "missing_flags",
                      "key_present",
                      "models",
                      "latency_ms",
                      "checked_at",
                      "reason_code"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "provider_id",
                  "status",
                  "probe"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "probe_id",
            "state",
            "results"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
