{
  "type": "object",
  "properties": {
    "track": {
      "default": "all",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "alg",
            "cs",
            "net",
            "lang",
            "fe",
            "be",
            "db",
            "linux",
            "docker",
            "k8s",
            "cicd",
            "sre",
            "cloud",
            "sec",
            "ml",
            "llm",
            "arch",
            "eng",
            "lead",
            "data"
          ]
        },
        {
          "type": "string",
          "const": "all"
        }
      ]
    },
    "layers": {
      "type": "string",
      "pattern": "^[a-z_]+(,[a-z_]+)*$"
    },
    "as_of": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blueprint_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:cert-[a-z0-9]+(?:-[a-z0-9]+)*@\\d{4})$"
    }
  },
  "required": [
    "track"
  ],
  "additionalProperties": false
}
