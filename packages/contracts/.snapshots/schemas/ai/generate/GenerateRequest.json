{
  "type": "object",
  "properties": {
    "lane": {
      "type": "string",
      "enum": ["interactive", "conversational"]
    },
    "input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "blocks": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "text": {
            "type": "string",
            "maxLength": 200000
          },
          "data_class": {
            "type": "string",
            "enum": ["C0", "C1", "C2", "C3"]
          },
          "untrusted": {
            "type": "boolean"
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["key", "text", "data_class", "untrusted", "source_ref"],
        "additionalProperties": false
      }
    },
    "context_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["attempt", "dialog_turn", "blank_note", "item", "import", "pack", "calibration", "appeal", "system"]
        },
        "phase": {
          "type": "string",
          "enum": ["pre_submit", "post_submit", "n_a"]
        },
        "id": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": ["kind", "phase", "id"],
      "additionalProperties": false
    },
    "stream": {
      "type": "boolean"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000
    },
    "family_exclude": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["anthropic", "openai", "google", "typesafe", "local", "other"]
      }
    },
    "local_only": {
      "type": "boolean"
    }
  },
  "required": ["lane", "input", "blocks", "context_ref", "stream", "deadline_ms", "family_exclude", "local_only"],
  "additionalProperties": false
}
