{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "FULL",
        "JUDGE_ONLY",
        "LLM_ONLY",
        "OFFLINE"
      ]
    },
    "previous_mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "FULL",
            "JUDGE_ONLY",
            "LLM_ONLY",
            "OFFLINE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "first_boot",
          "no_consent",
          "consent_granted",
          "consent_revoked",
          "probe_ok",
          "probe_failed",
          "breaker_open",
          "breaker_closed",
          "budget_exhausted",
          "quota_exhausted",
          "safe_mode",
          "key_added",
          "key_removed",
          "gateway_unreachable"
        ]
      }
    },
    "providers": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "jev",
              "llm_api",
              "llm_cli",
              "generic_cli",
              "local_llm"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down",
              "unconsented",
              "disabled"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "changed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "safe_mode": {
      "type": "boolean"
    }
  },
  "required": [
    "mode",
    "previous_mode",
    "reasons",
    "providers",
    "changed_at",
    "safe_mode"
  ],
  "additionalProperties": false
}
