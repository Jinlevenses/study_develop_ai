{
  "type": "object",
  "properties": {
    "mc_id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
    },
    "wrong_belief_ko": {
      "type": "string",
      "maxLength": 500
    },
    "correction_ko": {
      "type": "string",
      "maxLength": 1000
    },
    "meta_family": {
      "type": "string",
      "maxLength": 60
    },
    "refutes": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "retired"]
    }
  },
  "required": ["mc_id", "wrong_belief_ko", "correction_ko", "meta_family", "refutes", "status"],
  "additionalProperties": false
}
