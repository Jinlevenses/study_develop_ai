{
  "type": "object",
  "properties": {
    "flag": {
      "type": "string",
      "enum": ["too_easy", "too_hard", "distractor_dead", "discrimination_low", "key_suspect", "latency_outlier"]
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": ["limit"],
  "additionalProperties": false
}
