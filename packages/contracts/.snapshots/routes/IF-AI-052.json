{
  "$comment": "ai-gateway.firewall.log",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.firewall.log"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/firewall/log"
    },
    "allowedCallers": {
      "enum": [
        "gateway"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": true
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": [
        "FR-AI-019",
        "FR-AI-021"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,512}$"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "decision_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "ts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  },
                  "task_id": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "AI-J01",
                              "AI-J02",
                              "AI-J03",
                              "AI-J04",
                              "AI-J05",
                              "AI-J06",
                              "AI-J07",
                              "AI-J08",
                              "AI-J09",
                              "AI-J10",
                              "AI-J11",
                              "AI-J12",
                              "AI-J13",
                              "AI-J14",
                              "AI-J15",
                              "AI-J16",
                              "AI-J17",
                              "AI-J18",
                              "AI-J19"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "AI-G01",
                              "AI-G02",
                              "AI-G03",
                              "AI-G04",
                              "AI-G05",
                              "AI-G06",
                              "AI-G07",
                              "AI-G08",
                              "AI-G09",
                              "AI-G10",
                              "AI-G11",
                              "AI-G12",
                              "AI-G13"
                            ]
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "provider_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "data_class": {
                    "type": "string",
                    "enum": [
                      "C0",
                      "C1",
                      "C2",
                      "C3"
                    ]
                  },
                  "rule_hits": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 60
                    }
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "masked",
                      "force_local",
                      "block"
                    ]
                  }
                },
                "required": [
                  "decision_id",
                  "ts",
                  "task_id",
                  "provider_id",
                  "data_class",
                  "rule_hits",
                  "action"
                ],
                "additionalProperties": false
              }
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,512}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "items",
            "next_cursor"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
