{
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "misconception",
        "off_topic",
        "dont_know"
      ]
    },
    "mc_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "asks_for_answer": {
      "type": "boolean"
    },
    "engine": {
      "type": "string",
      "enum": [
        "D",
        "J",
        "LJ",
        "H",
        "S",
        "PENDING"
      ]
    },
    "calibrated": {
      "type": "boolean"
    },
    "badge": {
      "type": "string",
      "enum": [
        "none",
        "ai",
        "ai_uncalibrated",
        "ai_confirm",
        "ai_estimate_confirm",
        "heuristic",
        "self",
        "pending"
      ]
    }
  },
  "required": [
    "label",
    "mc_id",
    "asks_for_answer",
    "engine",
    "calibrated",
    "badge"
  ],
  "additionalProperties": false
}
