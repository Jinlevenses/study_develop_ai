            "created_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "updated_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": [
            "job_id",
            "source_kind",
            "title",
            "state",
            "stage",
            "stages",
            "trust",
            "masking",
            "data_class",
            "work_order_id",
            "quarantined_chunks",
            "diff_summary",
            "created_at",
            "updated_at"
