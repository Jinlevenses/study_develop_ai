    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "occurred_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "producer": {
      "type": "string",
      "enum": [
        "gateway",
        "content",
        "learning",
        "ai-gateway",
        "ops-api"
      ]
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "type",
    "schema_version",
    "event_id",
    "occurred_at",
    "correlation_id",
    "producer",
    "payload"
  ],
  "additionalProperties": false
