{
  "$comment": "gateway.cli.doctor",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.cli.doctor"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/api/v1/cli/doctor"
    },
    "allowedCallers": {
      "enum": ["cli"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-SET-003"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "op_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "fix": {
              "type": "boolean"
            },
            "live": {
              "type": "boolean"
            }
          },
          "required": ["op_id", "fix", "live"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "202": {
          "type": "object",
          "properties": {
            "op_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "backup",
                "restore",
                "rehearsal",
                "export",
                "import",
                "doctor",
                "upgrade",
                "rollback",
                "shutdown",
                "service_restart"
              ]
            },
            "state": {
              "type": "string",
              "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
            },
            "progress": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "string",
                  "maxLength": 60
                },
                "pct": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["step", "pct"],
              "additionalProperties": false
            },
            "correlation_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "started_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "finished_at": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "backup"
                        },
                        "epoch_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "backup_kind": {
                          "type": "string",
                          "enum": ["snapshot", "incremental"]
                        },
                        "outcome": {
                          "type": "string",
                          "enum": ["ok", "aborted", "failed"]
                        },
                        "reason": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 200
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "bytes": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "manifest_sha256": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["kind", "epoch_id", "backup_kind", "outcome", "reason", "bytes", "manifest_sha256"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "restore"
                        },
                        "epoch_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "projection_match": {
                          "type": ["boolean", "null"]
                        },
                        "incrementals_applied": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "rto_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["kind", "epoch_id", "projection_match", "incrementals_applied", "rto_ms"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "rehearsal"
                        },
                        "epoch_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "checksums_ok": {
                          "type": "boolean"
                        },
                        "row_counts_ok": {
                          "type": "boolean"
                        },
                        "projection_match": {
                          "type": ["boolean", "null"]
                        }
                      },
                      "required": ["kind", "epoch_id", "checksums_ok", "row_counts_ok", "projection_match"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "export"
                        },
                        "checkpoint_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "files": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string",
                                "maxLength": 1024
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "bytes": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": ["path", "sha256", "bytes"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["kind", "checkpoint_id", "files"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "import"
                        },
                        "ledger": {
                          "type": "object",
                          "properties": {
                            "import_id": {
                              "type": "string",
                              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                            },
                            "inserted": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "skipped_duplicates": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "violations": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["import_id", "inserted", "skipped_duplicates", "violations"],
                          "additionalProperties": false
                        },
                        "overlays": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "import_id": {
                                  "type": "string",
                                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                                },
                                "inserted": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "skipped": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "conflicts": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": ["import_id", "inserted", "skipped", "conflicts"],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "gold": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "import_id": {
                                  "type": "string",
                                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                                },
                                "inserted": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "skipped": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": ["import_id", "inserted", "skipped"],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "held_file": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 1024
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["kind", "ledger", "overlays", "gold", "held_file"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "doctor"
                        },
                        "report_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "fail": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "warn": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "fixed": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["kind", "report_id", "fail", "warn", "fixed"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "upgrade"
                        },
                        "from_version": {
                          "type": "string",
                          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                        },
                        "to_version": {
                          "type": "string",
                          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                        },
                        "pre_epoch_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "rolled_back": {
                          "type": "boolean"
                        }
                      },
                      "required": ["kind", "from_version", "to_version", "pre_epoch_id", "rolled_back"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "rollback"
                        },
                        "to_version": {
                          "type": "string",
                          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                        },
                        "restored_epoch_id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "held_events": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["kind", "to_version", "restored_epoch_id", "held_events"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "shutdown"
                        }
                      },
                      "required": ["kind"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "service_restart"
                        },
                        "svc": {
                          "type": "string",
                          "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                        },
                        "pid": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": ["kind", "svc", "pid"],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "problem": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "pattern": "^urn:fathom:problem:[a-z]+-[a-z]+-\\d{3}$"
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "detail": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "instance": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^(GW|CT|LR|AI|OP|CLI)-(VAL|AUTH|ACL|NOTFOUND|CONFLICT|DEP|LIMIT|POLICY|INTERNAL)-\\d{3}$"
                    },
                    "error_id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "request_id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "retry_after_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "errors": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "message": {
                            "type": "string",
                            "maxLength": 300
                          },
                          "rule": {
                            "type": "string",
                            "maxLength": 60
                          }
                        },
                        "required": ["path", "message", "rule"],
                        "additionalProperties": false
                      }
                    },
                    "dependency": {
                      "type": "string",
                      "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                    },
                    "acked_through_seq": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "active_session_id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "violations": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": ["type", "title", "status", "code", "error_id", "request_id", "retryable"],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op_id",
            "kind",
            "state",
            "progress",
            "correlation_id",
            "started_at",
            "finished_at",
            "result",
            "problem"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
