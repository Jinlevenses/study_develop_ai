{
  "type": "object",
  "properties": {
    "svc": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
        },
        {
          "type": "string",
          "const": "supervisor"
        }
      ]
    },
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error", "fatal"]
    },
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "from": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "to": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    },
    "limit": {
      "default": 100,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": ["limit"],
  "additionalProperties": false
}
