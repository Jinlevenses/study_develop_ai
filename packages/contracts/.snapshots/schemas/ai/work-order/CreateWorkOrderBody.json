{
  "type": "object",
  "properties": {
    "work_order_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "import",
        "generation",
        "regate",
        "tier_promotion",
        "pack_refresh",
        "calibration",
        "canary",
        "warming",
        "appeal_regrade",
        "pending_regrade"
      ]
    },
    "requested_by": {
      "type": "string",
      "enum": ["content", "user", "system"]
    },
    "context_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["attempt", "dialog_turn", "blank_note", "item", "import", "pack", "calibration", "appeal", "system"]
        },
        "phase": {
          "type": "string",
          "enum": ["pre_submit", "post_submit", "n_a"]
        },
        "id": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": ["kind", "phase", "id"],
      "additionalProperties": false
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "AI-J01",
                  "AI-J02",
                  "AI-J03",
                  "AI-J04",
                  "AI-J05",
                  "AI-J06",
                  "AI-J07",
                  "AI-J08",
                  "AI-J09",
                  "AI-J10",
                  "AI-J11",
                  "AI-J12",
                  "AI-J13",
                  "AI-J14",
                  "AI-J15",
                  "AI-J16",
                  "AI-J17",
                  "AI-J18",
                  "AI-J19"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "AI-G01",
                  "AI-G02",
                  "AI-G03",
                  "AI-G04",
                  "AI-G05",
                  "AI-G06",
                  "AI-G07",
                  "AI-G08",
                  "AI-G09",
                  "AI-G10",
                  "AI-G11",
                  "AI-G12",
                  "AI-G13"
                ]
              }
            ]
          },
          "calls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "est_input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "est_output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["task_id", "calls", "est_input_tokens", "est_output_tokens"],
        "additionalProperties": false
      }
    }
  },
  "required": ["work_order_id", "purpose", "requested_by", "context_ref", "tasks"],
  "additionalProperties": false
}
