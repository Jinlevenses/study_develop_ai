{
  "$comment": "ops.logs.search",
  "type": "object",
  "properties": {
    "id": {
      "const": "ops.logs.search"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/logs"
    },
    "allowedCallers": {
      "enum": ["gateway"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": true
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-SET-016", "NFR-AVL-007"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "svc": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                },
                {
                  "type": "string",
                  "const": "supervisor"
                }
              ]
            },
            "level": {
              "type": "string",
              "enum": ["debug", "info", "warn", "error", "fatal"]
            },
            "q": {
              "type": "string",
              "maxLength": 200
            },
            "from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "to": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "correlation_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "cursor": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,512}$"
            },
            "limit": {
              "default": 100,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": ["limit"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  },
                  "level": {
                    "type": "string",
                    "enum": ["debug", "info", "warn", "error", "fatal"]
                  },
                  "svc": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "msg": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "req_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "event": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 80
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "err_code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "correlation_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "trace_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "job": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "raw": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "ts",
                  "level",
                  "svc",
                  "msg",
                  "req_id",
                  "event",
                  "err_code",
                  "correlation_id",
                  "trace_id",
                  "job",
                  "raw"
                ],
                "additionalProperties": false
              }
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,512}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["items", "next_cursor"],
          "additionalProperties": false
        }
      }
    }
  }
}
