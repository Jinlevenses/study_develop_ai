{
  "type": "object",
  "properties": {
    "verdict_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "units": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "correct",
              "partial",
              "missing",
              "error"
            ]
          },
          "ku_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96,
                "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "ku_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict_id",
    "units"
  ],
  "additionalProperties": false
}
