{
  "type": "object",
  "properties": {
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "block_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "theory",
        "code",
        "core"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    }
  },
  "required": [
    "concept_id",
    "session_id",
    "block_id",
    "stage",
    "duration_ms",
    "study_day",
    "policy_version"
  ],
  "additionalProperties": false
}
