{
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*):[a-z][a-z_]{0,31}:(?:r|p))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "retired"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "user",
        "leech",
        "irrelevant",
        "pack_deprecated"
      ]
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    }
  },
  "required": [
    "card_id",
    "status",
    "reason",
    "study_day",
    "policy_version"
  ],
  "additionalProperties": false
}
