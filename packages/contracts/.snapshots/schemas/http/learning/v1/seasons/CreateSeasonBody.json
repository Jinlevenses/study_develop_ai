{
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "starts_on": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "weeks": {
      "type": "integer",
      "minimum": 6,
      "maximum": 8
    },
    "goals": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track": {
            "type": "string",
            "enum": [
              "alg",
              "cs",
              "net",
              "lang",
              "fe",
              "be",
              "db",
              "linux",
              "docker",
              "k8s",
              "cicd",
              "sre",
              "cloud",
              "sec",
              "ml",
              "llm",
              "arch",
              "eng",
              "lead",
              "data"
            ]
          },
          "target_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": ["track", "target_level"],
        "additionalProperties": false
      }
    },
    "premortem_ko": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "required": ["season_id", "starts_on", "weeks", "goals", "premortem_ko"],
  "additionalProperties": false
}
