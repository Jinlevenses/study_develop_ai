{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "gate_result"
    },
    "gate_result_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "subject_kind": {
      "type": "string",
      "enum": ["item", "item_model"]
    },
    "subject_id": {
      "type": "string",
      "maxLength": 140
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate": {
      "type": "string",
      "pattern": "^(G\\d{1,2}|V7|S2_APPROVAL|META)$"
    },
    "engine": {
      "type": "string",
      "enum": ["D", "J", "LJ", "H", "S", "USER", "ORACLE"]
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_context": {
      "type": "string",
      "const": "seed_build"
    },
    "pass": {
      "type": "boolean"
    },
    "score": {
      "type": ["number", "null"]
    },
    "probabilities": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "kind",
    "gate_result_id",
    "subject_kind",
    "subject_id",
    "content_hash",
    "gate",
    "engine",
    "provider_id",
    "run_context",
    "pass",
    "score",
    "probabilities",
    "detail"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
