{
  "$comment": "learning.practice.notes.draft",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.practice.notes.draft"
    },
    "method": {
      "const": "PUT"
    },
    "path": {
      "const": "/internal/v1/practice/notes/{block_id}/draft"
    },
    "allowedCallers": {
      "enum": ["gateway"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-STD-031"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["block_id"],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 20000
            },
            "updated_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "uncertain_spans": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              }
            }
          },
          "required": ["text", "updated_at", "uncertain_spans"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "saved_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": ["block_id", "saved_at"],
          "additionalProperties": false
        }
      }
    }
  }
}
