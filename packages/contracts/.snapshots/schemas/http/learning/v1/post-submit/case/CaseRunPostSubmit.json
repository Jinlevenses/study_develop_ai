{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "const": "post_submit"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "case_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.case\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "variant_id": {
      "type": "string",
      "maxLength": 64
    },
    "state": {
      "type": "string",
      "enum": ["graded", "awaiting_self_grade"]
    },
    "started_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "finished_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "decisions": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "option_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "verdict_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "best_option_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          }
        },
        "required": ["node_key", "option_key", "verdict_id", "score", "best_option_key"],
        "additionalProperties": false
      }
    },
    "score": {
      "type": "object",
      "properties": {
        "decision_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rubric_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "mttr_sim_min": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_efficiency": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "offline_weighting": {
          "type": "boolean"
        }
      },
      "required": [
        "decision_score",
        "rubric_score",
        "total",
        "mttr_sim_min",
        "evidence_efficiency",
        "offline_weighting"
      ],
      "additionalProperties": false
    },
    "debrief_md": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "phase",
    "run_id",
    "case_id",
    "variant_id",
    "state",
    "started_at",
    "finished_at",
    "decisions",
    "score",
    "debrief_md"
  ],
  "additionalProperties": false
}
