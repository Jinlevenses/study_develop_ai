{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "lesson"
        },
        "stages_done": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["theory", "code", "core"]
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["kind", "stages_done", "duration_ms"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "jol"
        },
        "predictions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": ["kind", "predictions"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "reflection"
        },
        "answers_ko": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "required": ["kind", "answers_ko"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "triage"
        },
        "decisions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["link", "probe", "import", "discard", "later"]
          }
        }
      },
      "required": ["kind", "decisions"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "generic"
        }
      },
      "required": ["kind"],
      "additionalProperties": false
    }
  ]
}
