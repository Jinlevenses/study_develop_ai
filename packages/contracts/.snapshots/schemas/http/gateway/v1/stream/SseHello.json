{
  "type": "object",
  "properties": {
    "boot_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "hub_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "server_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "app_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "ai_mode": {
      "type": "string",
      "enum": [
        "FULL",
        "JUDGE_ONLY",
        "LLM_ONLY",
        "OFFLINE"
      ]
    }
  },
  "required": [
    "boot_id",
    "hub_seq",
    "server_time",
    "app_version",
    "ai_mode"
  ],
  "additionalProperties": false
}
