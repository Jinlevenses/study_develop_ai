                    ]
                  },
                  "finished_at": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8640000000000000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "error_code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
