{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "header"
        },
        "v": {
          "type": "number",
          "const": 1
        },
        "generated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "since": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "v",
        "generated_at",
        "since"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "gold"
        },
        "item": {
          "type": "object",
          "properties": {
            "gold_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                {
                  "type": "string",
                  "pattern": "^gold\\.AI-J\\d{2}\\.\\d{3}$"
                }
              ]
            },
            "task_id": {
              "type": "string",
              "enum": [
                "AI-J01",
                "AI-J02",
                "AI-J03",
                "AI-J04",
                "AI-J05",
                "AI-J06",
                "AI-J07",
                "AI-J08",
                "AI-J09",
                "AI-J10",
                "AI-J11",
                "AI-J12",
                "AI-J13",
                "AI-J14",
                "AI-J15",
                "AI-J16",
                "AI-J17",
                "AI-J18",
                "AI-J19"
              ]
            },
            "template_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
            },
            "state": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "question_key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            },
            "label": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "noul"
                    },
                    "p_yes": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "type",
                    "p_yes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "choice"
                    },
                    "choice": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{1,31}$"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "probabilities": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{1,31}$"
                      },
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "required": [
                    "type",
                    "choice",
                    "confidence",
                    "probabilities"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "score"
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "probabilities": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^\\d{1,2}$"
                      },
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "levels": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "type",
                    "score",
                    "confidence",
                    "probabilities",
                    "levels"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "label_state": {
              "type": "string",
              "enum": [
                "user_confirmed",
                "user_corrected"
              ]
            },
            "confirmed_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": [
            "gold_id",
            "task_id",
            "template_version",
            "state",
            "question_key",
            "label",
            "label_state",
            "confirmed_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "item"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "end"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "count",
        "sha256"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
