{
  "type": "object",
  "properties": {
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "from_level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "to_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "provisional": {
      "type": "boolean"
    },
    "profile": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^ps_[0-9a-f]{16}$"
        },
        "ai_mode": {
          "type": "string",
          "enum": ["FULL", "JUDGE_ONLY", "LLM_ONLY", "OFFLINE"]
        }
      },
      "required": ["policy_version", "ai_mode"],
      "additionalProperties": false
    }
  },
  "required": ["track", "from_level", "to_level", "provisional", "profile"],
  "additionalProperties": false
}
