{
  "type": "object",
  "properties": {
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "outcome": {
      "type": "string",
      "enum": ["confirmed", "provisional_revoked"]
    },
    "needs_reconfirmation": {
      "type": "boolean"
    },
    "regrade_verdict_ids": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "required": ["track", "level", "outcome", "needs_reconfirmation", "regrade_verdict_ids", "study_day"],
  "additionalProperties": false
}
