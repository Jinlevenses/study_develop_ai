{
  "type": "object",
  "properties": {
    "app_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "prod",
        "dev",
        "test"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "health": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "overall": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "app_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "services": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "svc": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "gateway",
                      "content",
                      "learning",
                      "ai-gateway",
                      "ops-api"
                    ]
                  },
                  {
                    "type": "string",
                    "const": "supervisor"
                  }
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "starting",
                  "ready",
                  "restarting",
                  "degraded",
                  "stopped"
                ]
              },
              "pid": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "port": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "restarts_60s": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "started_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "degraded_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "svc",
              "state",
              "pid",
              "port",
              "restarts_60s",
              "started_at",
              "degraded_reason"
            ],
            "additionalProperties": false
          }
        },
        "ai": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "FULL",
                "JUDGE_ONLY",
                "LLM_ONLY",
                "OFFLINE"
              ]
            },
            "providers": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "degraded",
                      "down",
                      "unconsented",
                      "disabled"
                    ]
                  }
                },
                "required": [
                  "id",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "providers"
          ],
          "additionalProperties": false
        },
        "backup": {
          "type": "object",
          "properties": {
            "last_ok_at": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "rpo_hours": {
              "type": [
                "number",
                "null"
              ]
            },
            "secondary_configured": {
              "type": "boolean"
            },
            "last_outcome": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "ok",
                    "aborted",
                    "failed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "last_ok_at",
            "rpo_hours",
            "secondary_configured",
            "last_outcome"
          ],
          "additionalProperties": false
        },
        "outbox": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "svc": {
                "type": "string",
                "enum": [
                  "gateway",
                  "content",
                  "learning",
                  "ai-gateway",
                  "ops-api"
                ]
              },
              "dest": {
                "type": "string",
                "enum": [
                  "gateway",
                  "content",
                  "learning",
                  "ai-gateway",
                  "ops-api"
                ]
              },
              "pending": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "oldest_age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "svc",
              "dest",
              "pending",
              "oldest_age_ms"
            ],
            "additionalProperties": false
          }
        },
        "inbox": {
          "type": "object",
          "properties": {
            "dead_total": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "halted": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "svc": {
                    "type": "string",
                    "enum": [
                      "gateway",
                      "content",
                      "learning",
                      "ai-gateway",
                      "ops-api"
                    ]
                  },
                  "producer": {
                    "type": "string",
                    "enum": [
                      "gateway",
                      "content",
                      "learning",
                      "ai-gateway",
                      "ops-api"
                    ]
                  },
                  "since": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  }
                },
                "required": [
                  "svc",
                  "producer",
                  "since"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "dead_total",
            "halted"
          ],
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "queue_length": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "platform_reason": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "enabled",
            "queue_length",
            "platform_reason"
          ],
          "additionalProperties": false
        },
        "eventloop_p99_ms": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "gateway",
              "content",
              "learning",
              "ai-gateway",
              "ops-api"
            ]
          },
          "additionalProperties": {
            "type": "number"
          },
          "required": [
            "gateway",
            "content",
            "learning",
            "ai-gateway",
            "ops-api"
          ]
        },
        "rss_mb": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "disk": {
          "type": "object",
          "properties": {
            "free_mb": {
              "type": "number"
            },
            "warn": {
              "type": "boolean"
            }
          },
          "required": [
            "free_mb",
            "warn"
          ],
          "additionalProperties": false
        },
        "integrity": {
          "type": "object",
          "properties": {
            "ledger_alarm": {
              "type": "boolean"
            },
            "projection_match": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "last_full_check_at": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ledger_alarm",
            "projection_match",
            "last_full_check_at"
          ],
          "additionalProperties": false
        },
        "banners": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "banner_id": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "code": {
                "type": "string",
                "enum": [
                  "service_degraded",
                  "service_restarting",
                  "ai_offline",
                  "ai_budget_80",
                  "ai_budget_100",
                  "ai_quota",
                  "ai_drift",
                  "backup_failed",
                  "backup_aborted",
                  "secondary_missing",
                  "secondary_locked",
                  "rpo_exceeded",
                  "outbox_lag",
                  "inbox_dead",
                  "ledger_halt",
                  "ledger_integrity",
                  "projection_mismatch",
                  "integrity_check_failed",
                  "runner_platform_disabled",
                  "policy_lock_mismatch",
                  "prompt_lock_mismatch",
                  "disk_low",
                  "data_path_risk",
                  "node_eol",
                  "job_failed",
                  "slo_violation",
                  "tripwire",
                  "maintenance"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warn",
                  "critical"
                ]
              },
              "message_ko": {
                "type": "string",
                "maxLength": 300
              },
              "since": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              "dismissible": {
                "type": "boolean"
              },
              "action": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "label_ko": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "href": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cli": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 120
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "label_ko",
                      "href",
                      "cli"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "banner_id",
              "code",
              "severity",
              "message_ko",
              "since",
              "dismissible",
              "action"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "generated_at",
        "overall",
        "app_version",
        "services",
        "ai",
        "backup",
        "outbox",
        "inbox",
        "runner",
        "eventloop_p99_ms",
        "rss_mb",
        "disk",
        "integrity",
        "banners"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "app_version",
    "profile",
    "url",
    "health"
  ],
  "additionalProperties": false
}
