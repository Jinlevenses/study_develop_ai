{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "header"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "full": {
      "type": "boolean"
    },
    "pack_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pack_id": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)|x\\.[a-z0-9]+(?:-[a-z0-9]+)*|u\\.[a-z0-9]+)$"
          },
          "track": {
            "type": "string",
            "enum": [
              "alg",
              "cs",
              "net",
              "lang",
              "fe",
              "be",
              "db",
              "linux",
              "docker",
              "k8s",
              "cicd",
              "sre",
              "cloud",
              "sec",
              "ml",
              "llm",
              "arch",
              "eng",
              "lead",
              "data"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
          },
          "manifest_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["pack_id", "track", "version", "manifest_hash"],
        "additionalProperties": false
      }
    },
    "generated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    }
  },
  "required": ["kind", "v", "version", "full", "pack_set_hash", "packs", "generated_at"],
  "additionalProperties": false
}
