{
  "type": "object",
  "properties": {
    "move": {
      "type": "string",
      "enum": [
        "probe_why",
        "probe_how",
        "probe_what_if",
        "probe_edge",
        "probe_internal",
        "target_missing_ku",
        "counterexample",
        "hint_concept",
        "hint_ku",
        "hint_example",
        "refocus",
        "switch_to_explain",
        "student_question",
        "rebut",
        "wrap_up"
      ]
    },
    "target_ku_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_mc_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_sentences": {
          "type": "number",
          "const": 3
        },
        "single_question": {
          "type": "boolean",
          "const": true
        },
        "no_answer": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "max_sentences",
        "single_question",
        "no_answer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "move",
    "target_ku_id",
    "target_mc_id",
    "constraints"
  ],
  "additionalProperties": false
}
