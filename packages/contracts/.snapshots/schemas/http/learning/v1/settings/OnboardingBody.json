{
  "type": "object",
  "properties": {
    "career_years": {
      "type": "number",
      "minimum": 0,
      "maximum": 40
    },
    "weekly_minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 1200
    },
    "path_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(?:path\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "declarations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track": {
            "type": "string",
            "enum": [
              "alg",
              "cs",
              "net",
              "lang",
              "fe",
              "be",
              "db",
              "linux",
              "docker",
              "k8s",
              "cicd",
              "sre",
              "cloud",
              "sec",
              "ml",
              "llm",
              "arch",
              "eng",
              "lead",
              "data"
            ]
          },
          "declared_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": ["track", "declared_level"],
        "additionalProperties": false
      }
    }
  },
  "required": ["career_years", "weekly_minutes", "path_id", "declarations"],
  "additionalProperties": false
}
