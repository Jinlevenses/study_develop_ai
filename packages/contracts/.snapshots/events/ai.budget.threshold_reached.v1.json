{
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "money",
        "quota"
      ]
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ratio": {
      "anyOf": [
        {
          "type": "number",
          "const": 0.8
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "period": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}|\\d{4}-\\d{2}-\\d{2}T\\d{2}|\\d{4}-W\\d{2})$"
    }
  },
  "required": [
    "scope",
    "provider_id",
    "ratio",
    "period"
  ],
  "additionalProperties": false
}
