{
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "enum": ["content.db", "learning.db", "ai.db", "ops.db"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "schema": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z_][a-z0-9_-]{1,40}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "outbox_head_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "delivery": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "required": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
    },
    "inbox_watermark": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "required": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
    },
    "projection_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fsrs_impl": {
      "type": "string",
      "const": "ts-fsrs@5.4.2"
    },
    "ledger_head": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["seq", "hash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["file", "sha256", "bytes", "schema", "outbox_head_seq", "delivery", "inbox_watermark"],
  "additionalProperties": false
}
