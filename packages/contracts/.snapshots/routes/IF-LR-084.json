{
  "$comment": "learning.ledger.checkpoints",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.ledger.checkpoints"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/ledger/checkpoints"
    },
    "allowedCallers": {
      "enum": ["ops-api"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": true
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-SET-022"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,512}$"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": ["limit"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "checkpoint_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "devices": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "seq": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "head_hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": ["seq", "head_hash"],
                      "additionalProperties": false
                    }
                  },
                  "root_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "source_file_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "created_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  }
                },
                "required": ["checkpoint_id", "devices", "root_hash", "source_file_sha256", "created_at"],
                "additionalProperties": false
              }
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,512}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["items", "next_cursor"],
          "additionalProperties": false
        }
      }
    }
  }
}
