{
  "type": "object",
  "properties": {
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "retired",
        "leech"
      ]
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    }
  },
  "required": [
    "limit"
  ],
  "additionalProperties": false
}
