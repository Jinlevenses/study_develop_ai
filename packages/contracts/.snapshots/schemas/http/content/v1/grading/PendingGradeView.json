    "next_try_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "verdict_id",
    "attempt_id",
    "item_id",
    "format",
    "queued_at",
    "reason",
    "attempts",
    "next_try_at"
  ],
  "additionalProperties": false
}
