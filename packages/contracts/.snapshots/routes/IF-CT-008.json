              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
            },
            "nodes": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "concept_id": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
                  },
                  "title_ko": {
                    "type": "string"
                  },
                  "track": {
                    "type": "string",
                    "enum": [
                      "alg",
                      "cs",
                      "net",
                      "lang",
                      "fe",
                      "be",
                      "db",
                      "linux",
                      "docker",
                      "k8s",
                      "cicd",
                      "sre",
                      "cloud",
                      "sec",
                      "ml",
                      "llm",
                      "arch",
                      "eng",
                      "lead",
                      "data"
