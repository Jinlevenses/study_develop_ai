{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "attempt.graded",
        "evidence.upgraded",
        "evidence.regraded",
        "evidence.voided",
        "evidence.weight_adjusted",
        "pretest.answered",
        "lesson.completed",
        "self_assessment.recorded",
        "card.enrolled",
        "card.status_changed",
        "profile.setting_changed",
        "policy.switched",
        "ai_mode.observed",
        "declaration.sealed",
        "promotion.exam_completed",
        "level.promoted",
        "level.provisional_resolved"
      ]
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "client_ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "study_day": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 140,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "embedded",
            "ox",
            "mcq",
            "cloze",
            "short",
            "matching",
            "code_task",
            "blank_note",
            "digging_d4_mcq",
            "error_find",
            "confusable",
            "fermi",
            "cond_reversal",
            "infra_lite",
            "kata",
            "audit",
            "case_decision",
            "code_predict",
            "sql_task",
            "essay",
            "digging",
            "feynman",
            "pr_review",
            "reverse_item",
            "artifact",
            "case_postmortem",
            "micro_judgment",
            "ml_predict",
            "mcq_multi",
            "order",
            "parsons",
            "log_read",
            "config_review"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["correct", "partial", "incorrect", "pending"]
        },
        {
          "type": "null"
        }
      ]
    },
    "w": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "grader_engine": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["D", "J", "LJ", "H", "S", "PENDING"]
        },
        {
          "type": "null"
        }
      ]
    },
    "badge": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["none", "ai", "ai_uncalibrated", "ai_confirm", "ai_estimate_confirm", "heuristic", "self", "pending"]
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "voided": {
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "type",
    "device_id",
    "client_ts",
    "study_day",
    "item_id",
    "format",
    "result",
    "w",
    "grader_engine",
    "badge",
    "verdict_id",
    "superseded_by",
    "voided"
  ],
  "additionalProperties": false
}
