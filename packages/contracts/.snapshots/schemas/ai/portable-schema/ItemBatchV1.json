{
  "type": "object",
  "properties": {
    "items": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": ["mcq", "ox", "cloze", "short"]
          },
          "stem_md": {
            "type": "string",
            "maxLength": 4000
          },
          "options": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,31}$"
                },
                "text_md": {
                  "type": "string",
                  "maxLength": 2000
                },
                "mc_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["key", "text_md", "mc_id"],
              "additionalProperties": false
            }
          },
          "answer_keys": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            }
          },
          "accepted_answers": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "explanation_md": {
            "type": "string",
            "maxLength": 4000
          },
          "cited_ku_ids": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
            }
          },
          "bloom": {
            "type": "string",
            "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "assumptions": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "required": [
          "format",
          "stem_md",
          "options",
          "answer_keys",
          "accepted_answers",
          "explanation_md",
          "cited_ku_ids",
          "bloom",
          "difficulty",
          "assumptions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["items"],
  "additionalProperties": false
}
