{
  "$comment": "ai-gateway.usage.summary",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.usage.summary"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/usage"
    },
    "allowedCallers": {
      "enum": [
        "gateway",
        "ops-api"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": [
        "FR-AI-007",
        "FR-AI-021",
        "FR-AI-025"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "period": {
              "default": "month",
              "type": "string",
              "enum": [
                "day",
                "month"
              ]
            }
          },
          "required": [
            "period"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "period": {
              "type": "string",
              "enum": [
                "day",
                "month"
              ]
            },
            "period_start": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "money": {
              "type": "object",
              "properties": {
                "krw_spent": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "krw_budget": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "ratio": {
                  "type": "number",
                  "minimum": 0
                },
                "split": {
                  "type": "object",
                  "properties": {
                    "metered_krw": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "subscription_nominal_krw": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "metered_krw",
                    "subscription_nominal_krw"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "krw_spent",
                "krw_budget",
                "ratio",
                "split"
              ],
              "additionalProperties": false
            },
            "quota": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                  },
                  "window": {
                    "type": "string",
                    "enum": [
                      "5h",
                      "week"
                    ]
                  },
                  "used_pct": {
                    "type": "number",
                    "minimum": 0
                  },
                  "resets_at": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8640000000000000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "provider_id",
                  "window",
                  "used_pct",
                  "resets_at"
                ],
                "additionalProperties": false
              }
            },
            "by_task": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "AI-J01",
                          "AI-J02",
                          "AI-J03",
                          "AI-J04",
                          "AI-J05",
                          "AI-J06",
                          "AI-J07",
                          "AI-J08",
                          "AI-J09",
                          "AI-J10",
                          "AI-J11",
                          "AI-J12",
                          "AI-J13",
                          "AI-J14",
                          "AI-J15",
                          "AI-J16",
                          "AI-J17",
                          "AI-J18",
                          "AI-J19"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "AI-G01",
                          "AI-G02",
                          "AI-G03",
                          "AI-G04",
                          "AI-G05",
                          "AI-G06",
                          "AI-G07",
                          "AI-G08",
                          "AI-G09",
                          "AI-G10",
                          "AI-G11",
                          "AI-G12",
                          "AI-G13"
                        ]
                      }
                    ]
                  },
                  "calls": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "krw": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "p95_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fail_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fallback_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "task_id",
                  "calls",
                  "krw",
                  "p95_ms",
                  "fail_rate",
                  "fallback_rate"
                ],
                "additionalProperties": false
              }
            },
            "by_provider": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                  },
                  "calls": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "krw": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "provider_id",
                  "calls",
                  "krw"
                ],
                "additionalProperties": false
              }
            },
            "accepted_item_cost_krw": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "period",
            "period_start",
            "money",
            "quota",
            "by_task",
            "by_provider",
            "accepted_item_cost_krw"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
