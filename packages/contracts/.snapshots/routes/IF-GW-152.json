{
  "$comment": "gateway.ops.tripwires",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.ops.tripwires"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/api/v1/ops/tripwires"
    },
    "allowedCallers": {
      "enum": [
        "browser"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "NFR-AVL-008",
        "FR-SET-021"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {}
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "computed_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            },
            "learning": {
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^(TW-(0[1-9]|1[0-3])|GR-\\d{2})$"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "threshold": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "warn",
                      "trip",
                      "insufficient_data"
                    ]
                  }
                },
                "required": [
                  "id",
                  "value",
                  "threshold",
                  "state"
                ],
                "additionalProperties": false
              }
            },
            "resource": {
              "type": "object",
              "properties": {
                "idle_rss_total_mb": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "idle_rss_limit_mb": {
                  "type": "number"
                },
                "cold_start_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cold_start_limit_ms": {
                  "type": "number"
                },
                "disk_projection_15y_mb": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "idle_rss_total_mb",
                "idle_rss_limit_mb",
                "cold_start_ms",
                "cold_start_limit_ms",
                "disk_projection_15y_mb"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "computed_at",
            "learning",
            "resource"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
