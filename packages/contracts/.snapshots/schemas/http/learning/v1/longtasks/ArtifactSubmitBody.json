      "maxLength": 40000
    },
    "confidence": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["attempt_id", "text", "confidence"],
  "additionalProperties": false
}
