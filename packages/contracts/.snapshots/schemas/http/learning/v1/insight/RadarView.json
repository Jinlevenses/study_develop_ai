{
  "type": "object",
  "properties": {
    "at_risk": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
          },
          "retention": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "due_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "reason_ko": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "concept_id",
          "retention",
          "due_at",
          "reason_ko"
        ],
        "additionalProperties": false
      }
    },
    "computed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    }
  },
  "required": [
    "at_risk",
    "computed_at"
  ],
  "additionalProperties": false
}
