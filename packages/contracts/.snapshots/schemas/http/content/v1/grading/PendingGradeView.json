        "infra_lite",
        "kata",
        "audit",
        "case_decision",
        "code_predict",
        "sql_task",
        "essay",
        "digging",
        "feynman",
        "pr_review",
        "reverse_item",
        "artifact",
        "case_postmortem",
        "micro_judgment",
        "ml_predict",
        "mcq_multi",
        "order",
        "parsons",
        "log_read",
        "config_review"
      ]
    },
    "queued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "reason": {
      "type": "string",
      "enum": [
        "offline",
