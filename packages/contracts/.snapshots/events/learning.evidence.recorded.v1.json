{
  "type": "object",
  "properties": {
    "ledger_event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "verdict_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "item_id": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "format": {
      "type": "string",
      "enum": [
        "embedded",
        "ox",
        "mcq",
        "cloze",
        "short",
        "matching",
        "code_task",
        "blank_note",
        "digging_d4_mcq",
        "error_find",
        "confusable",
        "fermi",
        "cond_reversal",
        "infra_lite",
        "kata",
        "audit",
        "case_decision",
        "code_predict",
        "sql_task",
        "essay",
        "digging",
        "feynman",
        "pr_review",
        "reverse_item",
        "artifact",
        "case_postmortem",
        "micro_judgment",
        "ml_predict",
        "mcq_multi",
        "order",
        "parsons",
        "log_read",
        "config_review"
      ]
    },
    "result": {
      "type": "string",
      "enum": ["correct", "partial", "incorrect", "pending"]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rapid": {
      "type": "boolean"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_option_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ai_mode": {
      "type": "string",
      "enum": ["FULL", "JUDGE_ONLY", "LLM_ONLY", "OFFLINE"]
    },
    "recorded_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "phase": {
      "type": "string",
      "enum": ["practice", "pretest", "embedded", "verify", "promotion_exam", "placement", "boss"]
    },
    "item_beta_after": {
      "type": ["number", "null"]
    }
  },
  "required": [
    "ledger_event_id",
    "verdict_id",
    "item_id",
    "concept_id",
    "format",
    "result",
    "latency_ms",
    "rapid",
    "confidence",
    "selected_option_key",
    "ai_mode",
    "recorded_at",
    "phase",
    "item_beta_after"
  ],
  "additionalProperties": false
}
