{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "const": "post_submit"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "artifact_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.art\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "template_kind": {
      "type": "string",
      "enum": ["adr", "runbook", "postmortem", "design_review", "standard_clause"]
    },
    "state": {
      "type": "string",
      "enum": ["graded", "awaiting_self_grade", "rebuttal"]
    },
    "submitted_text": {
      "type": "string",
      "maxLength": 40000
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "verdict_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label_ko": {
            "type": "string",
            "maxLength": 60
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "max": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": ["label_ko", "score", "max"],
        "additionalProperties": false
      }
    },
    "rebuttal_dialog_ids": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "exemplar_md": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "phase",
    "run_id",
    "artifact_id",
    "template_kind",
    "state",
    "submitted_text",
    "attempt_id",
    "verdict_id",
    "dimensions",
    "rebuttal_dialog_ids",
    "exemplar_md"
  ],
  "additionalProperties": false
}
