{
  "$comment": "gateway.tracks.list",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.tracks.list"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/api/v1/tracks"
    },
    "allowedCallers": {
      "enum": ["browser"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R0"
    },
    "fr": {
      "enum": ["FR-CUR-001", "FR-CUR-025", "FR-PRG-013"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {}
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "tracks": {
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "track": {
                    "type": "string",
                    "enum": [
                      "alg",
                      "cs",
                      "net",
                      "lang",
                      "fe",
                      "be",
                      "db",
                      "linux",
                      "docker",
                      "k8s",
                      "cicd",
                      "sre",
                      "cloud",
                      "sec",
                      "ml",
                      "llm",
                      "arch",
                      "eng",
                      "lead",
                      "data"
                    ]
                  },
                  "title_ko": {
                    "type": "string"
                  },
                  "title_en": {
                    "type": "string"
                  },
                  "concept_counts": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    ],
                    "items": false,
                    "minItems": 5,
                    "maxItems": 5
                  },
                  "cap": {
                    "type": "object",
                    "properties": {
                      "declared": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "offline": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "oracle": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "display": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      }
                    },
                    "required": ["declared", "offline", "oracle", "display"],
                    "additionalProperties": false
                  },
                  "learner": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "level": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 5
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "provisional": {
                            "type": "boolean"
                          },
                          "needs_reconfirmation": {
                            "type": "boolean"
                          },
                          "mastered": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": ["level", "provisional", "needs_reconfirmation", "mastered"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["track", "title_ko", "title_en", "concept_counts", "cap", "learner"],
                "additionalProperties": false
              }
            },
            "degraded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.]{1,63}$"
                  },
                  "dependency": {
                    "type": "string",
                    "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^(GW|CT|LR|AI|OP|CLI)-(VAL|AUTH|ACL|NOTFOUND|CONFLICT|DEP|LIMIT|POLICY|INTERNAL)-\\d{3}$"
                  }
                },
                "required": ["part", "dependency", "code"],
                "additionalProperties": false
              }
            }
          },
          "required": ["tracks", "degraded"],
          "additionalProperties": false
        }
      }
    }
  }
}
