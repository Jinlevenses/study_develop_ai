                "v": {
                  "type": "number",
                  "const": 1
                },
                "generated_at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                "since": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 8640000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
