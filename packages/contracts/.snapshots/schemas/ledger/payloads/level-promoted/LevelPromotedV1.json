{
  "type": "object",
  "properties": {
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "from": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "to": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "provisional": {
      "type": "boolean"
    },
    "basis": {
      "type": "string",
      "enum": ["promotion_exam", "placement"]
    },
    "gates": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,40}$"
          },
          "label_ko": {
            "type": "string",
            "maxLength": 80
          },
          "met": {
            "type": "boolean"
          },
          "value": {
            "type": ["number", "null"]
          },
          "threshold": {
            "type": ["number", "null"]
          },
          "evidence_event_ids": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "shortfall_ko": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["gate_id", "label_ko", "met", "value", "threshold", "evidence_event_ids", "shortfall_ko"],
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^ps_[0-9a-f]{16}$"
        },
        "ai_mode": {
          "type": "string",
          "enum": ["FULL", "JUDGE_ONLY", "LLM_ONLY", "OFFLINE"]
        },
        "sp1_state": {
          "type": "string",
          "enum": ["pass", "fail", "unknown"]
        }
      },
      "required": ["policy_version", "ai_mode", "sp1_state"],
      "additionalProperties": false
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "required": ["track", "from", "to", "provisional", "basis", "gates", "profile", "study_day"],
  "additionalProperties": false
}
