{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "path"
    },
    "path_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:path\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "title_ko": {
      "type": "string",
      "maxLength": 120
    },
    "description_ko": {
      "type": "string",
      "maxLength": 500
    },
    "tracks": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "alg",
          "cs",
          "net",
          "lang",
          "fe",
          "be",
          "db",
          "linux",
          "docker",
          "k8s",
          "cicd",
          "sre",
          "cloud",
          "sec",
          "ml",
          "llm",
          "arch",
          "eng",
          "lead",
          "data"
        ]
      }
    },
    "concept_ids": {
      "minItems": 1,
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "path_id",
    "title_ko",
    "description_ko",
    "tracks",
    "concept_ids",
    "content_hash"
  ],
  "additionalProperties": false
}
