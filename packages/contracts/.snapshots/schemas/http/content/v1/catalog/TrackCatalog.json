              "three_stage": {
                "type": "object",
                "properties": {
                  "full": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lite": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
