{
  "type": "object",
  "properties": {
    "probe_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "providers": {
      "anyOf": [
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "live": {
      "type": "boolean"
    }
  },
  "required": [
    "probe_id",
    "providers",
    "live"
  ],
  "additionalProperties": false
}
