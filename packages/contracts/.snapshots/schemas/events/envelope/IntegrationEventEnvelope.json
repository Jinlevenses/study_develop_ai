{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "producer": {
      "type": "string",
      "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
    },
    "producer_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurred_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "traceparent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "event_id",
    "type",
    "schema_version",
    "producer",
    "producer_seq",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "additionalProperties": false
}
