{
  "$comment": "learning.insight.home",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.insight.home"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/insight/home"
    },
    "allowedCallers": {
      "enum": ["gateway"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R0"
    },
    "fr": {
      "enum": ["FR-DSH-001", "FR-PRG-006", "FR-PRG-020~022"]
    },
    "deadlineMs": {
      "const": 1200
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {}
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "primary_action": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["start_session", "resume_session", "onboarding", "return_mode", "paused"]
                },
                "label_ko": {
                  "type": "string",
                  "maxLength": 60
                },
                "suggested": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "minutes": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 5
                            },
                            {
                              "type": "number",
                              "const": 15
                            },
                            {
                              "type": "number",
                              "const": 25
                            },
                            {
                              "type": "number",
                              "const": 45
                            },
                            {
                              "type": "number",
                              "const": 90
                            }
                          ]
                        },
                        "energy": {
                          "type": "string",
                          "enum": ["light", "normal", "deep"]
                        }
                      },
                      "required": ["minutes", "energy"],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "session_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["kind", "label_ko", "suggested", "session_id"],
              "additionalProperties": false
            },
            "alerts": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "due_overflow",
                      "return_mode",
                      "paused",
                      "promotion_ready",
                      "verify_suggested",
                      "weekly_review_due",
                      "pending_grades",
                      "rating_confirm",
                      "policy_switch_available",
                      "onboarding"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": ["info", "warn", "critical"]
                  },
                  "message_ko": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "action": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "label_ko": {
                            "type": "string",
                            "maxLength": 40
                          },
                          "href": {
                            "type": "string",
                            "pattern": "^\\/(?!\\/)[A-Za-z0-9/_$.?=&-]*$"
                          }
                        },
                        "required": ["label_ko", "href"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["code", "severity", "message_ko", "action"],
                "additionalProperties": false
              }
            },
            "energy_default": {
              "type": "string",
              "enum": ["light", "normal", "deep"]
            },
            "minutes_default": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 5
                },
                {
                  "type": "number",
                  "const": 15
                },
                {
                  "type": "number",
                  "const": 25
                },
                {
                  "type": "number",
                  "const": 45
                },
                {
                  "type": "number",
                  "const": 90
                }
              ]
            },
            "today": {
              "type": "object",
              "properties": {
                "due_cards": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "new_budget": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "est_minutes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["due_cards", "new_budget", "est_minutes"],
              "additionalProperties": false
            },
            "weekly_goal": {
              "type": "object",
              "properties": {
                "target_sessions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 14
                },
                "done_sessions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "streak_weeks": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "rest_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["target_sessions", "done_sessions", "streak_weeks", "rest_tokens"],
              "additionalProperties": false
            }
          },
          "required": ["primary_action", "alerts", "energy_default", "minutes_default", "today", "weekly_goal"],
          "additionalProperties": false
        }
      }
    }
  }
}
