{
  "type": "object",
  "properties": {
    "policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    },
    "previous_policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    },
    "members": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,40}@v\\d{1,4}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["version", "sha256"],
        "additionalProperties": false
      }
    },
    "overrides_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "replay_report_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "required": [
    "policy_version",
    "previous_policy_version",
    "members",
    "overrides_sha256",
    "replay_report_ref",
    "study_day"
  ],
  "additionalProperties": false
}
