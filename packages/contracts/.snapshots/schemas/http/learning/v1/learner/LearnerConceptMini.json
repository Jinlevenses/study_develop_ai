{
  "type": "object",
  "properties": {
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "CL-0",
        "CL-1",
        "CL-2",
        "CL-3",
        "CL-4",
        "CL-5",
        "CL-6",
        "CL-7",
        "CL-8",
        "CL-X"
      ]
    },
    "mastery": {
      "type": "string",
      "enum": [
        "unseen",
        "learning",
        "mastered"
      ]
    },
    "provisional": {
      "type": "boolean"
    },
    "rusty": {
      "type": "boolean"
    }
  },
  "required": [
    "concept_id",
    "lifecycle",
    "mastery",
    "provisional",
    "rusty"
  ],
  "additionalProperties": false
}
