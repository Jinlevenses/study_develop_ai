{
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["ok", "error", "timeout", "memory_limit", "output_limit", "rejected", "platform_disabled"]
        },
        {
          "type": "string",
          "pattern": "^killed_[a-z_]{1,30}$"
        }
      ]
    },
    "stdout": {
      "type": "string",
      "maxLength": 65536
    },
    "stderr": {
      "type": "string",
      "maxLength": 65536
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "peak_rss_mb": {
      "type": "number",
      "minimum": 0
    },
    "output_truncated": {
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "public_tests": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "cases": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "case_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "message_ko": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["case_key", "ok", "message_ko"],
                "additionalProperties": false
              }
            }
          },
          "required": ["passed", "failed", "cases"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sql": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "columns": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 128
              }
            },
            "rows": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1024
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": ["columns", "rows", "truncated"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "run_id",
    "status",
    "stdout",
    "stderr",
    "exit_code",
    "duration_ms",
    "peak_rss_mb",
    "output_truncated",
    "reason",
    "public_tests",
    "sql"
  ],
  "additionalProperties": false
}
