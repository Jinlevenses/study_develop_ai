{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "self_grade",
        "jol",
        "regrade_rating_confirm",
        "bias_probe"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "concept",
            "item",
            "attempt",
            "ledger_event",
            "session"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "grade"
            },
            "grade": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "kind",
            "grade"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "probability"
            },
            "p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "p"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rating_confirm"
            },
            "accepted": {
              "type": "boolean"
            },
            "rating": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                },
                {
                  "type": "number",
                  "const": 4
                }
              ]
            }
          },
          "required": [
            "kind",
            "accepted",
            "rating"
          ],
          "additionalProperties": false
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "study_day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    }
  },
  "required": [
    "kind",
    "target",
    "value",
    "session_id",
    "study_day",
    "policy_version"
  ],
  "additionalProperties": false
}
