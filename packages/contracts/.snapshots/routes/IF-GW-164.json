{
  "$comment": "gateway.settings.policies_switch",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.settings.policies_switch"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/api/v1/settings/policies:switch"
    },
    "allowedCallers": {
      "enum": [
        "browser"
      ]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "FR-SET-018"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "preview_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "preview_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "policy_version": {
              "type": "string",
              "pattern": "^ps_[0-9a-f]{16}$"
            },
            "ledger_event_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "switched_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": [
            "policy_version",
            "ledger_event_id",
            "switched_at"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
