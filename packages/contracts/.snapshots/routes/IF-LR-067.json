{
  "$comment": "learning.settings.onboarding",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.settings.onboarding"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/settings/onboarding"
    },
    "allowedCallers": {
      "enum": [
        "gateway"
      ]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "FR-SET-019",
        "FR-PRG-014",
        "FR-PRG-025"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "career_years": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "weekly_minutes": {
              "type": "integer",
              "minimum": 15,
              "maximum": 1200
            },
            "path_id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^(?:path\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "declarations": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "track": {
                    "type": "string",
                    "enum": [
                      "alg",
                      "cs",
                      "net",
                      "lang",
                      "fe",
                      "be",
                      "db",
                      "linux",
                      "docker",
                      "k8s",
                      "cicd",
                      "sre",
                      "cloud",
                      "sec",
                      "ml",
                      "llm",
                      "arch",
                      "eng",
                      "lead",
                      "data"
                    ]
                  },
                  "declared_level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": [
                  "track",
                  "declared_level"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "career_years",
            "weekly_minutes",
            "path_id",
            "declarations"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "placement_tracks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "alg",
                  "cs",
                  "net",
                  "lang",
                  "fe",
                  "be",
                  "db",
                  "linux",
                  "docker",
                  "k8s",
                  "cicd",
                  "sre",
                  "cloud",
                  "sec",
                  "ml",
                  "llm",
                  "arch",
                  "eng",
                  "lead",
                  "data"
                ]
              }
            },
            "next": {
              "type": "string",
              "const": "placement_session"
            },
            "declaration_event_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "placement_tracks",
            "next",
            "declaration_event_id"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
