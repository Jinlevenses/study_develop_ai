{
  "$comment": "gateway.ops.backups",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.ops.backups"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/api/v1/ops/backups"
    },
    "allowedCallers": {
      "enum": ["browser"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": true
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-SET-004", "FR-SET-005"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,512}$"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": ["limit"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "epoch_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["snapshot", "incremental"]
                  },
                  "created_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  },
                  "outcome": {
                    "type": "string",
                    "enum": ["ok", "aborted", "failed"]
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "app_version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                  },
                  "manifest_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rehearsal": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "at": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 8640000000000000
                          },
                          "ok": {
                            "type": "boolean"
                          }
                        },
                        "required": ["at", "ok"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "secondary": {
                    "type": "object",
                    "properties": {
                      "copied_at": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 8640000000000000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "encrypted": {
                        "type": "boolean"
                      }
                    },
                    "required": ["copied_at", "encrypted"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "epoch_id",
                  "kind",
                  "created_at",
                  "outcome",
                  "size_bytes",
                  "app_version",
                  "manifest_sha256",
                  "rehearsal",
                  "secondary"
                ],
                "additionalProperties": false
              }
            },
            "next_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,512}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["items", "next_cursor"],
          "additionalProperties": false
        }
      }
    }
  }
}
