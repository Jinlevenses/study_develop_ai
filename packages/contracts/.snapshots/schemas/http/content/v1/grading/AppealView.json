{
  "type": "object",
  "properties": {
    "appeal_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "verdict_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "reason": {
      "type": "string",
      "enum": ["key_wrong", "ambiguous", "outdated", "learner_right", "other"]
    },
    "state": {
      "type": "string",
      "enum": ["received", "classifying", "regrading", "upheld", "rejected", "user_decision_required"]
    },
    "classification": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "enum": ["key_wrong", "ambiguous", "outdated", "learner_wrong"]
            },
            "engine": {
              "type": "string",
              "enum": ["D", "J", "LJ", "H", "S", "PENDING"]
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["label", "engine", "confidence"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "new_verdict_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rejection_reason_ko": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "decided_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "appeal_id",
    "verdict_id",
    "reason",
    "state",
    "classification",
    "new_verdict_id",
    "rejection_reason_ko",
    "created_at",
    "decided_at"
  ],
  "additionalProperties": false
}
