{
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "awaiting_work_order",
        "awaiting_approval",
        "published",
        "rejected",
        "failed",
        "cancelled"
      ]
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": ["limit"],
  "additionalProperties": false
}
