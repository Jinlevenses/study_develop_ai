{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "ku"
    },
    "ku_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "facet": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{0,31}$"
    },
    "scope": {
      "type": "string",
      "maxLength": 80
    },
    "vol": {
      "type": "string",
      "enum": [
        "stable",
        "evolving",
        "volatile"
      ]
    },
    "valid_as_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "deprecated_by": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "usage": {
            "type": "string",
            "enum": [
              "link_only",
              "paraphrase",
              "short_quote",
              "code_adapted"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "product_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "locator",
          "section",
          "usage",
          "retrieved_at",
          "product_version",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "authored",
        "verified",
        "user",
        "llm_unverified"
      ]
    },
    "origin": {
      "type": "string",
      "pattern": "^(authored|import:[0-9A-HJKMNP-TV-Z]{26}|tier_promotion:[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "needs_review",
        "deprecated"
      ]
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pack\\.[a-z_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "ku_id",
    "concept_id",
    "statement",
    "facet",
    "scope",
    "vol",
    "valid_as_of",
    "deprecated_by",
    "source_refs",
    "trust",
    "origin",
    "status",
    "ext",
    "content_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
