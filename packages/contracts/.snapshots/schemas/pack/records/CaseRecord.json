{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "case"
    },
    "case_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.case\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "track_id": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    },
    "case_kind": {
      "type": "string",
      "enum": [
        "incident",
        "design",
        "review",
        "migration",
        "tradeoff"
      ]
    },
    "title_ko": {
      "type": "string",
      "maxLength": 120
    },
    "spec": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "variant_params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "root_cause_pool": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "best_if": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rules": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "default_best": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          }
        },
        "required": [
          "rules",
          "default_best"
        ],
        "additionalProperties": false
      }
    },
    "contested": {
      "type": "boolean"
    },
    "rubric_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:rb\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "debrief_md": {
      "type": "string",
      "maxLength": 20000
    },
    "inspired_by": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "primary_sources": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "usage": {
            "type": "string",
            "enum": [
              "link_only",
              "paraphrase",
              "short_quote",
              "code_adapted"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "product_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "locator",
          "section",
          "usage",
          "retrieved_at",
          "product_version",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pack\\.[a-z_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "case_id",
    "track_id",
    "level",
    "case_kind",
    "title_ko",
    "spec",
    "variant_params",
    "root_cause_pool",
    "best_if",
    "contested",
    "rubric_id",
    "debrief_md",
    "inspired_by",
    "primary_sources",
    "ext",
