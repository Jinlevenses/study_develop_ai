{
  "$comment": "learning.learner.calibration",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.learner.calibration"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/learner/calibration"
    },
    "allowedCallers": {
      "enum": [
        "gateway"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "FR-PRG-023~025",
        "FR-DSH-010",
        "FR-QST-021"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "window_days": {
              "default": 30,
              "type": "integer",
              "minimum": 7,
              "maximum": 365
            }
          },
          "required": [
            "window_days"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "window_days": {
              "type": "integer",
              "minimum": 7,
              "maximum": 365
            },
            "cbm": {
              "type": "object",
              "properties": {
                "ratio": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "n": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "ratio",
                "n"
              ],
              "additionalProperties": false
            },
            "brier": {
              "type": [
                "number",
                "null"
              ]
            },
            "ece": {
              "type": [
                "number",
                "null"
              ]
            },
            "overconfidence": {
              "type": [
                "number",
                "null"
              ]
            },
            "bins": {
              "minItems": 3,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "confidence": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 1
                      },
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      }
                    ]
                  },
                  "n": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "accuracy": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "confidence",
                  "n",
                  "accuracy"
                ],
                "additionalProperties": false
              }
            },
            "illusion_concepts": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "concept_id": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
                  },
                  "gap": {
                    "type": "number"
                  }
                },
                "required": [
                  "concept_id",
                  "gap"
                ],
                "additionalProperties": false
              }
            },
            "declared_vs_proved": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "track": {
                    "type": "string",
                    "enum": [
                      "alg",
                      "cs",
                      "net",
                      "lang",
                      "fe",
                      "be",
                      "db",
                      "linux",
                      "docker",
                      "k8s",
                      "cicd",
                      "sre",
                      "cloud",
                      "sec",
                      "ml",
                      "llm",
                      "arch",
                      "eng",
                      "lead",
                      "data"
                    ]
                  },
                  "declared_level": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "proved_level": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "track",
                  "declared_level",
                  "proved_level"
                ],
                "additionalProperties": false
              }
            },
            "self_bias": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "coefficient": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "n": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "coefficient",
                    "n"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "window_days",
            "cbm",
            "brier",
            "ece",
            "overconfidence",
            "bins",
            "illusion_concepts",
            "declared_vs_proved",
            "self_bias"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
