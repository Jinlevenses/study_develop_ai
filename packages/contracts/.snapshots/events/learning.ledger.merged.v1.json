{
  "type": "object",
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "root_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imported_events": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "devices": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "head_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["device_id", "seq", "head_hash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["checkpoint_id", "root_hash", "imported_events", "devices"],
  "additionalProperties": false
}
