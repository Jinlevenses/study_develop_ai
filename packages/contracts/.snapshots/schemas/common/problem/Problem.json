{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^urn:fathom:problem:[a-z]+-[a-z]+-\\d{3}$"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "maxLength": 1000
    },
    "instance": {
      "type": "string",
      "maxLength": 300
    },
    "code": {
      "type": "string",
      "pattern": "^(GW|CT|LR|AI|OP|CLI)-(VAL|AUTH|ACL|NOTFOUND|CONFLICT|DEP|LIMIT|POLICY|INTERNAL)-\\d{3}$"
    },
    "error_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errors": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "maxLength": 300
          },
          "rule": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": ["path", "message", "rule"],
        "additionalProperties": false
      }
    },
    "dependency": {
      "type": "string",
      "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
    },
    "acked_through_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_session_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "violations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": ["type", "title", "status", "code", "error_id", "request_id", "retryable"],
  "additionalProperties": false
}
