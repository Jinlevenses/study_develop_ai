    },
    "fr": {
      "enum": ["FR-STD-020", "IR-016"]
    },
    "deadlineMs": {
      "const": 60000
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "sse"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["ref"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "string"
        }
      }
    }
  }
