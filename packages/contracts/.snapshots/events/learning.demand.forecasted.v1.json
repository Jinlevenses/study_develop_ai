{
  "type": "object",
  "properties": {
    "window_days": {
      "type": "number",
      "const": 14
    },
    "demand": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
          },
          "facet": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,31}$"
          },
          "format": {
            "type": "string",
            "enum": [
              "embedded",
              "ox",
              "mcq",
              "cloze",
              "short",
              "matching",
              "code_task",
              "blank_note",
              "digging_d4_mcq",
              "error_find",
              "confusable",
              "fermi",
              "cond_reversal",
              "infra_lite",
              "kata",
              "audit",
              "case_decision",
              "code_predict",
              "sql_task",
              "essay",
              "digging",
              "feynman",
              "pr_review",
              "reverse_item",
              "artifact",
              "case_postmortem",
              "micro_judgment",
              "ml_predict",
              "mcq_multi",
              "order",
              "parsons",
              "log_read",
              "config_review"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["concept_id", "facet", "format", "level", "n"],
        "additionalProperties": false
      }
    },
    "computed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    }
  },
  "required": ["window_days", "demand", "computed_at"],
  "additionalProperties": false
}
