{
  "$comment": "learning.practice.self_assessments.create",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.practice.self_assessments.create"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/practice/sessions/{session_id}/self-assessments"
    },
    "allowedCallers": {
      "enum": ["gateway"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": ["FR-QST-021"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["session_id"],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "assessment_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "kind": {
              "type": "string",
              "enum": ["self_grade", "bias_probe"]
            },
            "target": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["item", "attempt"]
                },
                "id": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": ["kind", "id"],
              "additionalProperties": false
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": ["assessment_id", "kind", "target", "value"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "201": {
          "type": "object",
          "properties": {
            "ledger_event_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["ledger_event_id"],
          "additionalProperties": false
        }
      }
    }
  }
}
