{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "edge"
    },
    "from_concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "to_concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "edge_kind": {
      "type": "string",
      "enum": ["prereq", "sibling", "extends"]
    },
    "weight": {
      "type": "number"
    }
  },
  "required": ["kind", "from_concept_id", "to_concept_id", "edge_kind", "weight"],
  "additionalProperties": false
}
