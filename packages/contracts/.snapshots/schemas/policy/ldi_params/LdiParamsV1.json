        "core": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "standard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "breadth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "archive": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retired": {
          "type": "number",
          "const": 0
        }
      },
      "required": ["core", "standard", "breadth", "archive", "retired"],
      "additionalProperties": false
    },
    "depth_by_level": {
      "type": "object",
      "properties": {
        "L0": {
          "type": "number",
          "minimum": 0
        },
        "L1": {
          "type": "number",
          "minimum": 0
        },
        "L2": {
          "type": "number",
          "minimum": 0
        },
        "L3": {
          "type": "number",
          "minimum": 0
        },
        "L4": {
          "type": "number",
          "minimum": 0
        },
        "L5": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["L0", "L1", "L2", "L3", "L4", "L5"],
      "additionalProperties": false
