          "type": "object",
          "properties": {
            "import_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "inserted": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "skipped": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["import_id", "inserted", "skipped"],
          "additionalProperties": false
        }
      }
    }
  }
}
