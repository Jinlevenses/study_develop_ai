{
  "type": "object",
  "properties": {
    "secrets": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
          },
          "source": {
            "type": "string",
            "enum": [
              "keychain",
              "file",
              "env"
            ]
          },
          "last4": {
            "type": "string",
            "minLength": 4,
            "maxLength": 4
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider_id",
          "source",
          "last4",
          "verified_at"
        ],
        "additionalProperties": false
      }
    },
    "store": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "keychain",
            "file",
            "env_only"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "kek_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "os",
                "passphrase"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "backend",
        "locked",
        "kek_kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "secrets",
    "store"
  ],
  "additionalProperties": false
}
