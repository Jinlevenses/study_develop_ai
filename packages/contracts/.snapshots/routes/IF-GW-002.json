{
  "$comment": "gateway.session.exchange",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.session.exchange"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/api/v1/session/exchange"
    },
    "allowedCallers": {
      "enum": [
        "browser"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R0"
    },
    "fr": {
      "enum": [
        "NFR-SEC-019"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "bt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          "required": [
            "bt"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "session_established": {
              "type": "boolean",
              "const": true
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "app_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
            },
            "profile": {
              "type": "string",
              "enum": [
                "prod",
                "dev",
                "test"
              ]
            }
          },
          "required": [
            "session_established",
            "port",
            "app_version",
            "profile"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
