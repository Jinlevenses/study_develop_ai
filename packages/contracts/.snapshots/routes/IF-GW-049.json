{
  "$comment": "gateway.concepts.outdated_report",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.concepts.outdated_report"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/api/v1/concepts/{concept_id}/outdated-reports"
    },
    "allowedCallers": {
      "enum": [
        "browser"
      ]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R3"
    },
    "fr": {
      "enum": [
        "FR-CUR-014"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "concept_id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
            }
          },
          "required": [
            "concept_id"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "ku_ids": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
              }
            },
            "note_ko": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "report_id",
            "ku_ids",
            "note_ko"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "201": {
          "type": "object",
          "properties": {
            "report_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "concept_id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
            },
            "state": {
              "type": "string",
              "enum": [
                "received",
                "revalidating",
                "resolved"
              ]
            },
            "cl_x": {
              "type": "boolean"
            },
            "created_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8640000000000000
            }
          },
          "required": [
            "report_id",
            "concept_id",
            "state",
            "cl_x",
            "created_at"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
