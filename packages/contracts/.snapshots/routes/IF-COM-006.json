{
  "$comment": "common.admin.snapshot",
  "type": "object",
  "properties": {
    "id": {
      "const": "common.admin.snapshot"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/admin/snapshot"
    },
    "allowedCallers": {
      "enum": ["ops-api"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": []
    },
    "deadlineMs": {
      "const": 30000
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "epoch_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["epoch_id", "dir"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "epoch_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "svc": {
              "type": "string",
              "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
            },
            "files": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "enum": ["content.db", "learning.db", "ai.db", "ops.db"]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["file", "sha256", "bytes"],
                "additionalProperties": false
              }
            },
            "schema": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_-]{1,40}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "outbox_head_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "delivery": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "required": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
            },
            "inbox_watermark": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "required": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
            },
            "projection_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "fsrs_impl": {
              "type": "string",
              "const": "ts-fsrs@5.4.2"
            },
            "ledger_head": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "seq": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": ["seq", "hash"],
                "additionalProperties": false
              }
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "epoch_id",
            "svc",
            "files",
            "schema",
            "outbox_head_seq",
            "delivery",
            "inbox_watermark",
            "duration_ms"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
