{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["confirm", "correct", "skip"]
    },
    "corrected_label": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "noul"
                },
                "p_yes": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["type", "p_yes"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "choice"
                },
                "choice": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,31}$"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "probabilities": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "required": ["type", "choice", "confidence", "probabilities"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "score"
                },
                "score": {
                  "type": "number",
                  "minimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "probabilities": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^\\d{1,2}$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "levels": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 10
                }
              },
              "required": ["type", "score", "confidence", "probabilities", "levels"],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["decision", "corrected_label"],
  "additionalProperties": false
}
