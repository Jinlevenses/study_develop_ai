{
  "type": "object",
  "properties": {
    "authenticated": {
      "type": "boolean",
      "const": true
    },
    "port": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "app_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "profile": {
      "type": "string",
      "enum": ["prod", "dev", "test"]
    },
    "safe_mode": {
      "type": "boolean"
    },
    "maintenance": {
      "type": "string",
      "enum": ["none", "restore", "upgrade"]
    }
  },
  "required": ["authenticated", "port", "app_version", "boot_id", "profile", "safe_mode", "maintenance"],
  "additionalProperties": false
}
