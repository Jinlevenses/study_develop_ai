{
  "$comment": "ai-gateway.generate.run",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.generate.run"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/generate/{task_id}"
    },
    "allowedCallers": {
      "enum": ["content"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": ["FR-AI-004", "FR-AI-006", "FR-AI-020", "FR-AI-023", "FR-STD-020", "IR-001~007", "IR-018"]
    },
    "deadlineMs": {
      "const": 120000
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,20}$"
            }
          },
          "required": ["task_id"],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "lane": {
              "type": "string",
              "enum": ["interactive", "conversational"]
            },
            "input": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "blocks": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 200000
                  },
                  "data_class": {
                    "type": "string",
                    "enum": ["C0", "C1", "C2", "C3"]
                  },
                  "untrusted": {
                    "type": "boolean"
                  },
                  "source_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["key", "text", "data_class", "untrusted", "source_ref"],
                "additionalProperties": false
              }
            },
            "context_ref": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "attempt",
                    "dialog_turn",
                    "blank_note",
                    "item",
                    "import",
                    "pack",
                    "calibration",
                    "appeal",
                    "system"
                  ]
                },
                "phase": {
                  "type": "string",
                  "enum": ["pre_submit", "post_submit", "n_a"]
                },
                "id": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": ["kind", "phase", "id"],
              "additionalProperties": false
            },
            "stream": {
              "type": "boolean"
            },
            "deadline_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 120000
            },
            "family_exclude": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["anthropic", "openai", "google", "typesafe", "local", "other"]
              }
            },
            "local_only": {
              "type": "boolean"
            }
          },
          "required": [
            "lane",
            "input",
            "blocks",
            "context_ref",
            "stream",
            "deadline_ms",
            "family_exclude",
            "local_only"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "ok"
                },
                "output": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "schema_id": {
                  "type": "string",
                  "pattern": "^ai\\/[A-Za-z]+@\\d+$"
                },
                "provider_id": {
                  "type": "string",
                  "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                },
                "model": {
                  "type": "string",
                  "maxLength": 80
                },
                "prompt_version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                },
                "repaired": {
                  "type": "boolean"
                },
                "cache_hit": {
                  "type": "boolean"
                },
                "call_id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "firewall_decision_id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "basis": {
                      "type": "string",
                      "enum": ["reported", "computed", "subscription", "free"]
                    },
                    "krw": {
                      "type": "number",
                      "minimum": 0
                    },
                    "usd": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["basis", "krw", "usd"],
                  "additionalProperties": false
                },
                "latency_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "status",
                "output",
                "schema_id",
                "provider_id",
                "model",
                "prompt_version",
                "repaired",
                "cache_hit",
                "call_id",
                "firewall_decision_id",
                "cost",
                "latency_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "streaming"
                },
                "stream_ref": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "expires_at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8640000000000000
                },
                "provider_id": {
                  "type": "string",
                  "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                },
                "prompt_version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                },
                "call_id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                }
              },
              "required": ["status", "stream_ref", "expires_at", "provider_id", "prompt_version", "call_id"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "offline",
                    "no_consented_provider",
                    "auth_invalid",
                    "breaker_open",
                    "deadline",
                    "firewall_blocked",
                    "budget_exhausted",
                    "quota_exhausted",
                    "task_disabled",
                    "provider_error",
                    "schema_violation",
                    "content_refused",
                    "busy"
                  ]
                },
                "retry_after_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["status", "reason", "retry_after_ms"],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
