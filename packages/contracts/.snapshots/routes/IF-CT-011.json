                  "enum": [
                    "alg",
                    "cs",
                    "net",
                    "lang",
                    "fe",
                    "be",
                    "db",
                    "linux",
                    "docker",
                    "k8s",
                    "cicd",
                    "sre",
                    "cloud",
                    "sec",
                    "ml",
                    "llm",
                    "arch",
                    "eng",
                    "lead",
                    "data"
                  ]
                },
