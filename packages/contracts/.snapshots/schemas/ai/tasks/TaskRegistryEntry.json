{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "judge",
        "generate"
      ]
    },
    "lane": {
      "type": "string",
      "enum": [
        "interactive",
        "conversational",
        "background"
      ]
    },
    "chain": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "jev",
          "llm-judge",
          "llm"
        ]
      }
    },
    "question_types": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "noul",
          "choice",
          "score"
        ]
      }
    },
    "max_questions_per_request": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "schema": {
      "type": "string",
      "pattern": "^ai\\/[A-Za-z]+@\\d+$"
    },
    "tier": {
      "type": "string",
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "prompt": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "AI-J01",
                "AI-J02",
                "AI-J03",
                "AI-J04",
                "AI-J05",
                "AI-J06",
                "AI-J07",
                "AI-J08",
                "AI-J09",
                "AI-J10",
                "AI-J11",
                "AI-J12",
                "AI-J13",
                "AI-J14",
                "AI-J15",
                "AI-J16",
                "AI-J17",
                "AI-J18",
                "AI-J19"
              ]
            },
            {
              "type": "string",
              "enum": [
                "AI-G01",
                "AI-G02",
                "AI-G03",
                "AI-G04",
                "AI-G05",
                "AI-G06",
                "AI-G07",
                "AI-G08",
                "AI-G09",
                "AI-G10",
                "AI-G11",
                "AI-G12",
                "AI-G13"
              ]
            }
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "active",
            "candidate"
          ]
        }
      },
      "required": [
        "id",
        "channel"
      ],
      "additionalProperties": false
    },
    "prefer": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
      }
    },
    "deny": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "data_class_max": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "family_constraint": {
      "type": "string",
      "enum": [
        "none",
        "different_from_generator"
      ]
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "requires_work_order": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "lane",
    "chain",
    "data_class_max",
    "family_constraint",
    "deadline_ms",
    "requires_work_order"
  ],
  "additionalProperties": false
}
