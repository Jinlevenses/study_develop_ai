{
  "$comment": "gateway.paths.list",
  "type": "object",
  "properties": {
    "id": {
      "const": "gateway.paths.list"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/api/v1/paths"
    },
    "allowedCallers": {
      "enum": ["browser"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-CUR-019"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {}
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "paths": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path_id": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^(?:path\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                  },
                  "title_ko": {
                    "type": "string"
                  },
                  "description_ko": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "tracks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "alg",
                        "cs",
                        "net",
                        "lang",
                        "fe",
                        "be",
                        "db",
                        "linux",
                        "docker",
                        "k8s",
                        "cicd",
                        "sre",
                        "cloud",
                        "sec",
                        "ml",
                        "llm",
                        "arch",
                        "eng",
                        "lead",
                        "data"
                      ]
                    }
                  },
                  "concept_ids": {
                    "maxItems": 300,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
                    }
                  }
                },
                "required": ["path_id", "title_ko", "description_ko", "tracks", "concept_ids"],
                "additionalProperties": false
              }
            }
          },
          "required": ["paths"],
          "additionalProperties": false
        }
      }
    }
  }
}
