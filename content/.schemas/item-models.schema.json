{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "number",
      "const": 1
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^im\\d{2}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "t1"
              },
              "generator": {
                "type": "string",
                "enum": [
                  "t1.js_output",
                  "t1.event_loop_order",
                  "t1.sql_result",
                  "t1.regex_match",
                  "t1.cidr",
                  "t1.http_status",
                  "t1.big_o",
                  "t1.cron",
                  "t1.bitwise",
                  "t1.docker_layer_cache",
                  "t1.k8s_yaml_defect",
                  "t1.fermi"
                ]
              },
              "format": {
                "type": "string",
                "enum": ["code_predict", "short", "mcq", "order", "fermi", "config_review"]
              },
              "facet": {
                "type": "string",
                "enum": ["definition", "mechanism", "code", "tradeoff", "contrast", "operation"]
              },
              "response_mode": {
                "type": "string",
                "enum": ["recognition", "production"]
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "bloom": {
                "type": "string",
                "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
              },
              "stem_family": {
                "type": "string",
                "pattern": "^sf_[a-z0-9_]{2,28}$"
              },
              "params": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,31}$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "int"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "step": {
                          "default": 1,
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["type", "min", "max"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "enum"
                        },
                        "values": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{1,31}$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "maxLength": 80
                          }
                        }
                      },
                      "required": ["type", "values"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "ku_refs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:k\\d{2}|[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.k\\d{2})$"
                }
              }
            },
            "required": [
              "kind",
              "generator",
              "format",
              "facet",
              "response_mode",
              "level",
              "bloom",
              "stem_family",
              "ku_refs"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "t2"
              },
              "format": {
                "type": "string",
                "enum": ["ox", "mcq", "cloze", "short", "matching"]
              },
              "facet": {
                "type": "string",
                "enum": ["definition", "mechanism", "code", "tradeoff", "contrast", "operation"]
              },
              "response_mode": {
                "type": "string",
                "enum": ["recognition", "production"]
              },
              "stem_family": {
                "type": "string",
                "pattern": "^sf_[a-z0-9_]{2,28}$"
              },
              "source": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "enum": ["ku", "mc", "ku_set"]
                  },
                  "ku_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "definition",
                        "property",
                        "mechanism",
                        "procedure_step",
                        "constraint",
                        "comparison",
                        "syntax",
                        "config_fact",
                        "failure_mode",
                        "tradeoff",
                        "heuristic",
                        "example"
                      ]
                    }
                  },
                  "ku_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?:k\\d{2}|[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.k\\d{2})$"
                    }
                  }
                },
                "required": ["from"],
                "additionalProperties": false
              },
              "template": {
                "type": "object",
                "properties": {
                  "stem": {
                    "type": "string",
                    "maxLength": 600
                  },
                  "options": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^opt_[a-h]$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "answer": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": ["stem", "answer"],
                "additionalProperties": false
              },
              "constraints": {
                "type": "object",
                "properties": {
                  "dedupe_jaccard": {
                    "default": 0.85,
                    "type": "number"
                  },
                  "max_instances": {
                    "default": 12,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  }
                },
                "additionalProperties": false
              },
              "metamorphic": {
                "type": "object",
                "properties": {
                  "preserve": {
                    "default": ["option_order"],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["paraphrase", "option_order"]
                    }
                  },
                  "flip": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["negate_condition", "swap_sibling"]
                    }
                  }
                },
                "additionalProperties": false
              },
              "stakes_max": {
                "type": "string",
                "const": "S1"
              }
            },
            "required": [
              "kind",
              "format",
              "facet",
              "response_mode",
              "stem_family",
              "source",
              "template",
              "constraints",
              "metamorphic",
              "stakes_max"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["schema_v", "concept_id", "models"],
  "additionalProperties": false
}
