{
  "$comment": "common.admin.events",
  "type": "object",
  "properties": {
    "id": {
      "const": "common.admin.events"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/admin/events"
    },
    "allowedCallers": {
      "enum": ["ops-api"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": []
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "correlation_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["correlation_id"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "svc": {
              "type": "string",
              "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
            },
            "outbox": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "seq": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "event_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$"
                  },
                  "occurred_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  },
                  "causation_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "delivered": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    },
                    "required": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                  }
                },
                "required": ["seq", "event_id", "type", "occurred_at", "causation_id", "delivered"],
                "additionalProperties": false
              }
            },
            "inbox": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "event_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "producer": {
                    "type": "string",
                    "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                  },
                  "producer_seq": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$"
                  },
                  "received_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  }
                },
                "required": ["event_id", "producer", "producer_seq", "type", "received_at"],
                "additionalProperties": false
              }
            },
            "dead": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "event_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "producer": {
                    "type": "string",
                    "enum": ["gateway", "content", "learning", "ai-gateway", "ops-api"]
                  },
                  "type": {
                    "type": "string",
                    "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$"
                  },
                  "error_code": {
                    "type": "string"
                  },
                  "failed_at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8640000000000000
                  },
                  "resolution": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["replayed", "discarded"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["event_id", "producer", "type", "error_code", "failed_at", "resolution"],
                "additionalProperties": false
              }
            }
          },
          "required": ["svc", "outbox", "inbox", "dead"],
          "additionalProperties": false
        }
      }
    }
  }
}
