{
  "type": "object",
  "properties": {
    "epoch_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "type": "string",
      "enum": ["snapshot", "incremental", "rehearsal"]
    },
    "outcome": {
      "type": "string",
      "enum": ["ok", "aborted", "failed"]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "rpo_hours": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["epoch_id", "kind", "outcome", "reason", "rpo_hours"],
  "additionalProperties": false
}
