{
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "scope": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "all"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "path"
                },
                "path_id": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^(?:path\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                }
              },
              "required": [
                "kind",
                "path_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "tracks"
                },
                "tracks": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "alg",
                      "cs",
                      "net",
                      "lang",
                      "fe",
                      "be",
                      "db",
                      "linux",
                      "docker",
                      "k8s",
                      "cicd",
                      "sre",
                      "cloud",
                      "sec",
                      "ml",
                      "llm",
                      "arch",
                      "eng",
                      "lead",
                      "data"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "tracks"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "concepts"
                },
                "concept_ids": {
                  "minItems": 1,
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
                  }
                }
              },
              "required": [
                "kind",
                "concept_ids"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "template": {
      "type": "string",
      "enum": [
        "standard",
        "placement",
        "verify",
        "promotion_exam",
        "weak_drill",
        "dday",
        "return"
      ]
    },
    "blocks_total": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "blocks_done": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "modes": {
      "maxItems": 21,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^M-(0[1-9]|1\\d|2[01])$"
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "first_item_latency_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    }
  },
  "required": [
    "session_id",
    "scope",
    "template",
    "blocks_total",
    "blocks_done",
    "modes",
    "duration_ms",
    "first_item_latency_ms",
    "completed_at"
  ],
  "additionalProperties": false
}
