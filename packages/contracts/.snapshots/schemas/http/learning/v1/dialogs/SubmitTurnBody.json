{
  "type": "object",
  "properties": {
    "turn_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "answered_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "d4_choice": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "maxLength": 140,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
            },
            "item_content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "option_keys": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              }
            }
          },
          "required": ["item_id", "item_content_hash", "option_keys"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["turn_id", "text", "answered_at", "d4_choice"],
  "additionalProperties": false
}
