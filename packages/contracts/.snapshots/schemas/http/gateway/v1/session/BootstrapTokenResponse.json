{
  "type": "object",
  "properties": {
    "bootstrap_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "open_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["bootstrap_token", "expires_at", "open_url"],
  "additionalProperties": false
}
