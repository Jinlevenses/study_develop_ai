{
  "type": "object",
  "properties": {
    "patch_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "concept",
        "ku",
        "misconception",
        "item",
        "case",
        "source"
      ]
    },
    "target_id": {
      "type": "string",
      "maxLength": 160
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+){0,3}$"
    },
    "base_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_value": {
      "$ref": "#/$defs/__schema0"
    },
    "reason_ko": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "patch_id",
    "target_kind",
    "target_id",
    "field",
    "base_version",
    "new_value",
    "reason_ko"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
