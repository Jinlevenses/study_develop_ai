{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "number",
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^v7\\.[a-z0-9.]+\\.\\d{3}$"
    },
    "pack_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "record_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["record_ids"],
      "additionalProperties": false
    },
    "policy": {
      "type": "string",
      "enum": ["tier_a_20pct", "tier_b_5pct", "t2_5pct", "full"]
    },
    "author": {
      "type": "object",
      "properties": {
        "wp": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "context_id": {
          "type": "string"
        }
      },
      "required": ["wp", "model_id", "context_id"],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "wp": {
          "type": "string",
          "const": "WP-REV"
        },
        "model_id": {
          "type": "string"
        },
        "context_id": {
          "type": "string"
        },
        "prompt_id": {
          "type": "string",
          "pattern": "^review\\.v7\\.[a-z_]+@\\d+\\.\\d+\\.\\d+$"
        },
        "tier": {
          "type": "string",
          "const": "upper"
        }
      },
      "required": ["wp", "model_id", "context_id", "prompt_id", "tier"],
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "sampled_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["seed", "sampled_ids"],
      "additionalProperties": false
    },
    "checklist_version": {
      "type": "string",
      "const": "v7-checklist@1"
    },
    "findings": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^f_\\d{2,3}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor"]
          },
          "category": {
            "type": "string",
            "enum": [
              "fact",
              "key",
              "ambiguity",
              "leak",
              "level_fit",
              "korean",
              "license",
              "format",
              "safety",
              "pedagogy"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "resolution": {
            "type": "string",
            "enum": ["fixed", "wont_fix", "deferred"]
          }
        },
        "required": ["record_id", "severity", "category", "note", "resolution"],
        "additionalProperties": false
      }
    },
    "defect_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision": {
      "type": "string",
      "enum": ["approve", "rework"]
    },
    "approved_hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema_v",
    "batch_id",
    "pack_id",
    "created_at",
    "scope",
    "policy",
    "author",
    "reviewer",
    "sampling",
    "checklist_version",
    "defect_rate",
    "decision",
    "approved_hashes"
  ],
  "additionalProperties": false
}
