{
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "usage": {
      "type": "string",
      "enum": ["link_only", "paraphrase", "short_quote", "code_adapted"]
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "product_version": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "quote": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["source_id", "locator", "section", "usage", "retrieved_at", "product_version", "quote"],
  "additionalProperties": false
}
