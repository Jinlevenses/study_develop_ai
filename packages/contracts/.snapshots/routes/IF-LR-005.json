{
  "$comment": "learning.practice.blocks.alternatives",
  "type": "object",
  "properties": {
    "id": {
      "const": "learning.practice.blocks.alternatives"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/practice/sessions/{session_id}/blocks/{block_id}/alternatives"
    },
    "allowedCallers": {
      "enum": [
        "gateway"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "FR-STD-006"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "block_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": [
            "session_id",
            "block_id"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "block_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "candidates": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "mode_id": {
                    "type": "string",
                    "pattern": "^M-(0[1-9]|1\\d|2[01])$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "lesson",
                      "items",
                      "blank_note",
                      "dialog",
                      "lab",
                      "case",
                      "artifact",
                      "jol",
                      "reflection",
                      "triage"
                    ]
                  },
                  "concept_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason_chips": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "due",
                            "keystone",
                            "new",
                            "weekly_quota",
                            "wildcard",
                            "boss",
                            "warmup",
                            "closer",
                            "nba",
                            "scope",
                            "interleave",
                            "dday",
                            "return",
                            "verify",
                            "promotion",
                            "placement",
                            "weak"
                          ]
                        },
                        "label_ko": {
                          "type": "string",
                          "maxLength": 40
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 40
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "code",
                        "label_ko",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "est_minutes": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "candidate_id",
                  "mode_id",
                  "kind",
                  "concept_id",
                  "reason_chips",
                  "est_minutes"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "block_id",
            "candidates"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
