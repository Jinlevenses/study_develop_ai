{
  "$comment": "content.catalog.cases.list",
  "type": "object",
  "properties": {
    "id": {
      "const": "content.catalog.cases.list"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/catalog/cases"
    },
    "allowedCallers": {
      "enum": ["gateway"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R3"
    },
    "fr": {
      "enum": ["FR-STD-025", "FR-CUR-016"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "track": {
              "type": "string",
              "enum": [
                "alg",
                "cs",
                "net",
                "lang",
                "fe",
                "be",
                "db",
                "linux",
                "docker",
                "k8s",
                "cicd",
                "sre",
                "cloud",
                "sec",
                "ml",
                "llm",
                "arch",
                "eng",
                "lead",
                "data"
              ]
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "cases": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "case_id": {
                    "type": "string",
                    "maxLength": 96,
                    "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.case\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                  },
                  "title_ko": {
                    "type": "string"
                  },
                  "tracks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "alg",
                        "cs",
                        "net",
                        "lang",
                        "fe",
                        "be",
                        "db",
                        "linux",
                        "docker",
                        "k8s",
                        "cicd",
                        "sre",
                        "cloud",
                        "sec",
                        "ml",
                        "llm",
                        "arch",
                        "eng",
                        "lead",
                        "data"
                      ]
                    }
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "variants": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "floor": {
                    "type": "boolean"
                  }
                },
                "required": ["case_id", "title_ko", "tracks", "level", "variants", "floor"],
                "additionalProperties": false
              }
            }
          },
          "required": ["cases"],
          "additionalProperties": false
        }
      }
    }
  }
}
