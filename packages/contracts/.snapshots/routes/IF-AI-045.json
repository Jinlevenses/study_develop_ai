{
  "$comment": "ai-gateway.calibration.gold_import",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.calibration.gold_import"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/calibration/gold/import"
    },
    "allowedCallers": {
      "enum": ["ops-api"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": ["FR-SET-006", "FR-SET-022"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": 8589934592
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "ndjson"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "import_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["import_id"],
          "additionalProperties": false
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
