{
  "type": "object",
  "properties": {
    "summary_md": {
      "type": "string",
      "maxLength": 4000
    },
    "per_point": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "note_md": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": ["key", "note_md"],
        "additionalProperties": false
      }
    },
    "cited_ku_ids": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
      }
    }
  },
  "required": ["summary_md", "per_point", "cited_ku_ids"],
  "additionalProperties": false
}
