{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "item"
    },
    "item_id": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "origin": {
      "type": "string",
      "enum": ["pack", "runtime"]
    },
    "model_id": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*))$"
            },
            {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "family_id": {
      "type": "string",
      "maxLength": 120
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "ku_ids": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
      }
    },
    "mc_ids": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
      }
    },
    "facet": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{0,31}$"
    },
    "format": {
      "type": "string",
      "enum": [
        "embedded",
        "ox",
        "mcq",
        "cloze",
        "short",
        "matching",
        "code_task",
        "blank_note",
        "digging_d4_mcq",
        "error_find",
        "confusable",
        "fermi",
        "cond_reversal",
        "infra_lite",
        "kata",
        "audit",
        "case_decision",
        "code_predict",
        "sql_task",
        "essay",
        "digging",
        "feynman",
        "pr_review",
        "reverse_item",
        "artifact",
        "case_postmortem",
        "micro_judgment",
        "ml_predict",
        "mcq_multi",
        "order",
        "parsons",
        "log_read",
        "config_review"
      ]
    },
    "response_mode": {
      "type": "string",
      "enum": ["recognition", "production"]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "bloom": {
      "type": "string",
      "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
    },
    "stakes": {
      "type": "string",
      "enum": ["S0", "S1", "S2"]
    },
    "tier": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "n_options": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "beta_prior": {
      "type": "number"
    },
    "stem": {
      "$ref": "#/$defs/__schema0"
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "answer_key": {
      "$ref": "#/$defs/__schema2"
    },
    "explanation_md": {
      "type": "string",
      "maxLength": 20000
    },
    "distractor_mc": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
      }
    },
    "lab_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(?:(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": ["seed", "t1", "t2", "t3", "t4", "gap", "user_error", "past_self", "user_authored", "repo", "imported"]
    },
    "stem_family": {
      "type": "string",
      "pattern": "^sf_[a-z0-9_]{2,28}$"
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "authored",
        "seed_reviewed",
        "draft",
        "deferred",
        "gated_pass",
        "gated_fail",
        "jev_verified",
        "flagged",
        "demoted",
        "quarantined",
        "retired"
      ]
    },
    "defect_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "s2_mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["cross_family", "same_family", "v7_review"]
        },
        {
          "type": "null"
        }
      ]
    },
    "lineage": {
      "$ref": "#/$defs/__schema4"
    },
    "snapshot": {
      "$ref": "#/$defs/__schema5"
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pack\\.[a-z_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "item_id",
    "origin",
    "model_id",
    "family_id",
    "concept_id",
    "ku_ids",
    "mc_ids",
    "facet",
    "format",
    "response_mode",
    "level",
    "bloom",
    "stakes",
    "tier",
    "n_options",
