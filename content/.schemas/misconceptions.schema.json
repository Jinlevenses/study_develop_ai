{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "number",
      "const": 1
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "mcs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^m\\d{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sibling_confusion",
              "overgeneralization",
              "causal_reversal",
              "version_drift",
              "boundary",
              "mechanism_confusion",
              "quantifier",
              "analogy_overreach",
              "security_false_sense"
            ]
          },
          "meta_family": {
            "type": "string",
            "enum": [
              "mf_phase_confusion",
              "mf_state_vs_event",
              "mf_mean_vs_tail",
              "mf_sync_async_boundary",
              "mf_copy_vs_share",
              "mf_scope_overreach",
              "mf_causal_reversal",
              "mf_version_drift",
              "mf_layer_responsibility",
              "mf_guarantee_overtrust",
              "mf_cost_blindness",
              "mf_boundary_case"
            ]
          },
          "wrong_belief": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          },
          "correction": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "refutes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^k\\d{2}$"
            }
          },
          "prevalence": {
            "type": "string",
            "enum": ["high", "mid", "low"]
          },
          "source_refs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "usage": {
                  "type": "string",
                  "enum": ["link_only", "paraphrase", "short_quote", "code_adapted"]
                },
                "retrieved_at": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "product_version": {
                  "type": "string",
                  "maxLength": 40
                },
                "quote": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": ["source_id", "locator", "section", "usage", "retrieved_at"],
              "additionalProperties": false
            }
          }
        },
        "required": ["kind", "meta_family", "wrong_belief", "correction", "refutes", "prevalence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_v", "concept_id", "mcs"],
  "additionalProperties": false
}
