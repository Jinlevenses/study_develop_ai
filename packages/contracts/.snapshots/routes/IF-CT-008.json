{
  "$comment": "content.catalog.concepts.neighbors",
  "type": "object",
  "properties": {
    "id": {
      "const": "content.catalog.concepts.neighbors"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/catalog/concepts/{concept_id}/neighbors"
    },
    "allowedCallers": {
      "enum": ["gateway"]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": ["FR-CUR-018"]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "concept_id": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
            }
          },
          "required": ["concept_id"],
          "additionalProperties": false
        },
        "query": {
          "type": "object",
          "properties": {
            "depth": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          },
          "required": ["depth"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
