{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FW-(SEC|PII|NET|USR|LCL|LOC)-\\d{3}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "action": {
      "type": "string",
      "enum": [
        "mask",
        "block",
        "force_local"
      ]
    },
    "group": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "c0_action": {
      "type": "string",
      "const": "mask"
    },
    "span": {
      "type": "string",
      "const": "until_end_marker"
    },
    "except_allow_literals": {
      "type": "boolean",
      "const": true
    },
    "validate": {
      "type": "string",
      "const": "luhn"
    },
    "class": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "pattern",
    "action"
  ],
  "additionalProperties": false
}
