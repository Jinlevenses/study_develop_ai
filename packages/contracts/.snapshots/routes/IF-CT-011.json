                    "lang",
                    "fe",
                    "be",
                    "db",
                    "linux",
                    "docker",
                    "k8s",
                    "cicd",
                    "sre",
                    "cloud",
                    "sec",
                    "ml",
                    "llm",
                    "arch",
                    "eng",
                    "lead",
                    "data"
                  ]
                },
                {
                  "type": "string",
                  "const": "all"
                }
              ]
            }
          },
          "required": ["track"],
          "additionalProperties": false
        }
      }
    },
    "response": {
