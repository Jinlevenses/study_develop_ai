{
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "down",
        "unconsented",
        "disabled"
      ]
    },
    "breaker": {
      "type": "string",
      "enum": [
        "closed",
        "open",
        "half_open"
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "provider_id",
    "status",
    "breaker",
    "reason_code"
  ],
  "additionalProperties": false
}
