    "pricing": {
      "type": "object",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
              },
              "match": {
                "type": "string",
                "maxLength": 80
              },
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "cache_read": {
                "type": "number"
              }
            },
            "required": ["provider", "match", "in", "out", "cache_read"],
            "additionalProperties": false
          }
        },
        "unknown_model": {
          "type": "object",
          "properties": {
            "in": {
              "type": "number"
            },
            "out": {
              "type": "number"
            },
            "cache_read": {
              "type": "number"
            }
          },
          "required": ["in", "out", "cache_read"],
          "additionalProperties": false
        }
      },
      "required": ["as_of", "models", "unknown_model"],
      "additionalProperties": false
