{
  "type": "object",
  "properties": {
    "dialog_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "dialog_kind": {
      "type": "string",
      "enum": ["dig", "feynman", "artifact_rebuttal"]
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "depth_max_allowed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "state_summary": {
      "type": "object",
      "properties": {
        "moves": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "probe_why",
              "probe_how",
              "probe_what_if",
              "probe_edge",
              "probe_internal",
              "target_missing_ku",
              "counterexample",
              "hint_concept",
              "hint_ku",
              "hint_example",
              "refocus",
              "switch_to_explain",
              "student_question",
              "rebut",
              "wrap_up"
            ]
          }
        },
        "covered_ku_ids": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
          }
        },
        "flagged_mc_ids": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.m\\d{2})$"
          }
        },
        "fail_streak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asks_for_answer_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turn_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["moves", "covered_ku_ids", "flagged_mc_ids", "fail_streak", "asks_for_answer_count", "turn_count"],
      "additionalProperties": false
    },
    "turn_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "d4_choice": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "maxLength": 140,
              "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
            },
            "item_content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "option_keys": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              }
            }
          },
          "required": ["item_id", "item_content_hash", "option_keys"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "verdict_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["run_id", "attempt_id", "verdict_id"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_params": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^ps_[0-9a-f]{16}$"
        },
        "w_format": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w_grader_table": {
          "type": "object",
          "properties": {
            "D": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "J_calibrated": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "J_uncalibrated": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "J_low_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "LJ": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "H": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "S": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "PENDING": {
              "type": "number",
              "const": 0
            }
          },
          "required": ["D", "J_calibrated", "J_uncalibrated", "J_low_confidence", "LJ", "H", "S", "PENDING"],
          "additionalProperties": false
        },
        "rapid": {
          "type": "boolean"
        },
        "gaming_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["policy_version", "w_format", "w_grader_table", "rapid", "gaming_factor"],
      "additionalProperties": false
    },
    "ai_mode_observed": {
      "type": "string",
      "enum": ["FULL", "JUDGE_ONLY", "LLM_ONLY", "OFFLINE"]
    }
  },
  "required": [
    "dialog_id",
    "turn_id",
    "dialog_kind",
    "concept_id",
    "session_id",
    "level",
    "depth",
    "depth_max_allowed",
    "state_summary",
    "turn_text",
    "d4_choice",
    "artifact_ref",
    "evidence_params",
    "ai_mode_observed"
  ],
  "additionalProperties": false
}
