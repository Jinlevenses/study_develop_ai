        "recover_per_min": {
          "type": "number"
        }
      },
      "required": ["decrease", "recover_per_min"],
      "additionalProperties": false
    },
    "breaker": {
      "type": "object",
      "properties": {
        "window_s": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "failures": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "error_rate": {
          "type": "number"
        },
        "min_calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "open_s": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "open_max_s": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["window_s", "failures", "error_rate", "min_calls", "open_s", "open_max_s"],
      "additionalProperties": false
    },
    "mode": {
      "type": "object",
      "properties": {
        "upgrade_hold_s": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
