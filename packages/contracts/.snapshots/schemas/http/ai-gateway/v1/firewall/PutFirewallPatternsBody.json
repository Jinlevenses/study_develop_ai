{
  "type": "object",
  "properties": {
    "user_patterns": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "domain",
              "employee_id",
              "project_code",
              "regex",
              "literal"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          }
        },
        "required": [
          "pattern_id",
          "kind",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "local_classifier_enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "user_patterns",
    "local_classifier_enabled"
  ],
  "additionalProperties": false
}
