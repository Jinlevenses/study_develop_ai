{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "backup",
        "restore",
        "rehearsal",
        "export",
        "import",
        "doctor",
        "upgrade",
        "rollback",
        "shutdown",
        "service_restart"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "limit"
  ],
  "additionalProperties": false
}
