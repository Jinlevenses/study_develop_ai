              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 5,
            "maxItems": 5
          },
          "cap": {
            "type": "object",
            "properties": {
              "declared": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "offline": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "oracle": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
