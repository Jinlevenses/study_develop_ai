{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "policy_set"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    },
    "members": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,40}@v\\d{1,4}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["version", "sha256"],
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,40}@v\\d{1,4}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "yaml": {
            "type": "string",
            "maxLength": 1000000
          }
        },
        "required": ["sha256", "yaml"],
        "additionalProperties": false
      }
    }
  },
  "required": ["kind", "policy_version", "members", "documents"],
  "additionalProperties": false
}
