{
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.i\\d{2,3}|(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*)\\.x[0-9a-f]{12}|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.lab\\.[a-z0-9]+(?:-[a-z0-9]+)*|[0-9A-HJKMNP-TV-Z]{26})$"
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "authored",
        "seed_reviewed",
        "draft",
        "deferred",
        "gated_pass",
        "gated_fail",
        "jev_verified",
        "flagged",
        "demoted",
        "quarantined",
        "retired"
      ]
    },
    "stem_family": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "changed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "affected_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": ["item_id", "gate_status", "stem_family", "changed_at", "affected_items"],
  "additionalProperties": false
}
