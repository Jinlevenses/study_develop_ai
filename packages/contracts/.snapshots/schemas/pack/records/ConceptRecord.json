{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "concept"
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "track_id": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "knowledge_type": {
      "type": "string",
      "enum": ["D", "C", "P", "S"]
    },
    "tier": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "title_ko": {
      "type": "string",
      "maxLength": 60
    },
    "title_en": {
      "type": "string",
      "maxLength": 80
    },
    "summary_ko": {
      "type": "string",
      "maxLength": 160
    },
    "aliases": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "tags": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(qa|lc|ctx|stack|cert|mode):[a-z0-9_.-]{1,40}$"
      }
    },
    "volatility": {
      "type": "string",
      "enum": ["stable", "evolving", "volatile"]
    },
    "required_for_level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "deprecated_by": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "theory_md": {
      "type": "string",
      "maxLength": 40000
    },
    "code_md": {
      "type": "string",
      "maxLength": 40000
    },
    "core_md": {
      "type": "string",
      "maxLength": 20000
    },
    "diagrams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mermaid": {
            "type": "string",
            "maxLength": 20000
          },
          "alt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          }
        },
        "required": ["mermaid", "alt", "summary"],
        "additionalProperties": false
      }
    },
    "sources": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "usage": {
            "type": "string",
            "enum": ["link_only", "paraphrase", "short_quote", "code_adapted"]
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "product_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["source_id", "locator", "section", "usage", "retrieved_at", "product_version", "quote"],
        "additionalProperties": false
      }
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pack\\.[a-z_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "concept_id",
    "track_id",
    "level",
    "knowledge_type",
    "tier",
    "title_ko",
    "title_en",
    "summary_ko",
    "aliases",
    "tags",
    "volatility",
    "required_for_level",
    "deprecated_by",
    "theory_md",
    "code_md",
    "core_md",
    "diagrams",
    "sources",
    "ext",
    "content_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
