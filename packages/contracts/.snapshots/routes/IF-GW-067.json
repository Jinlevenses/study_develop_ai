      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": ["FR-STD-019", "FR-QST-023"]
    },
    "deadlineMs": {
      "const": 60000
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "sse"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "verdict_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "required": ["verdict_id"],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "string"
        }
      }
    }
  }
}
