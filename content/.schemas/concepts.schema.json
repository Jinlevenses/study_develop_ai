{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "tier": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "knowledge_type": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "enum": ["D", "C", "P", "S"]
        },
        "secondary": {
          "default": [],
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["D", "C", "P", "S"]
          }
        }
      },
      "required": ["primary"],
      "additionalProperties": false
    },
    "stage2_kind": {
      "type": "string",
      "enum": ["code", "case"]
    },
    "title": {
      "type": "object",
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": ["ko", "en"],
      "additionalProperties": false
    },
    "summary_ko": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "aliases": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "tags": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(qa|lc|ctx|stack|cert|mode):[a-z0-9_.-]{1,40}$"
      }
    },
    "volatility": {
      "type": "string",
      "enum": ["stable", "evolving", "volatile"]
    },
    "required_for_level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "prereqs": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
      }
    },
    "siblings": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          }
        },
        "required": ["axis"],
        "additionalProperties": false
      }
    },
    "extends": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
      }
    },
    "deprecated_by": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "id_aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
      }
    },
    "sources": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "usage": {
            "type": "string",
            "enum": ["link_only", "paraphrase", "short_quote", "code_adapted"]
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "product_version": {
            "type": "string",
            "maxLength": 40
          },
          "quote": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": ["source_id", "locator", "section", "usage", "retrieved_at"],
        "additionalProperties": false
      }
    },
    "diagrams": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "alt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 40,
            "maxLength": 400
          }
        },
        "required": ["alt", "summary"],
        "additionalProperties": false
      }
    },
    "learning": {
      "type": "object",
      "properties": {
        "objectives": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "bloom": {
                "type": "string",
                "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
              },
              "text": {
                "type": "string",
                "minLength": 10,
                "maxLength": 140
              }
            },
            "required": ["bloom", "text"],
            "additionalProperties": false
          }
        },
        "depth_facets": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": ["l2", "l3", "l4", "l5"]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200
          }
        },
        "pre_questions": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 140
          }
        },
        "contrast_pairs": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "axis": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": ["a", "b", "axis"],
            "additionalProperties": false
          }
        },
        "mnemonic": {
          "type": "string",
          "maxLength": 80
        },
        "estimated_minutes": {
          "type": "object",
          "properties": {
            "theory": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 90
            },
            "core": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": ["theory", "code", "core"],
          "additionalProperties": false
        }
      },
      "required": ["objectives", "pre_questions", "estimated_minutes"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "verified_against": {
          "type": "string",
          "maxLength": 60
        },
        "valid_as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "review_by": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": ["valid_as_of", "review_by"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_v",
    "id",
    "track",
    "level",
    "tier",
    "knowledge_type",
    "stage2_kind",
    "title",
    "summary_ko",
    "aliases",
    "volatility",
    "required_for_level",
    "sources",
    "review"
  ],
  "additionalProperties": false
}
