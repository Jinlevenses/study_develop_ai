{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "item_model"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:im\\d{2}|imx-[a-z0-9]+(?:-[a-z0-9]+)*))$"
        },
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "pack",
        "runtime"
      ]
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "format": {
      "type": "string",
      "enum": [
        "embedded",
        "ox",
        "mcq",
        "cloze",
        "short",
        "matching",
        "code_task",
        "blank_note",
        "digging_d4_mcq",
        "error_find",
        "confusable",
        "fermi",
        "cond_reversal",
        "infra_lite",
        "kata",
        "audit",
        "case_decision",
        "code_predict",
        "sql_task",
        "essay",
        "digging",
        "feynman",
        "pr_review",
        "reverse_item",
        "artifact",
        "case_postmortem",
        "micro_judgment",
        "ml_predict",
        "mcq_multi",
        "order",
        "parsons",
        "log_read",
        "config_review"
      ]
    },
    "ku_ids": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "constraints": {
      "$ref": "#/$defs/__schema1"
    },
    "metamorphic": {
      "$ref": "#/$defs/__schema2"
    },
    "stem_family": {
      "type": "string",
      "pattern": "^sf_[a-z0-9_]{2,28}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "author": {
      "type": "string",
      "enum": [
        "seed",
        "llm",
        "user"
      ]
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sample_gate": {
      "$ref": "#/$defs/__schema3"
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pack\\.[a-z_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "model_id",
    "origin",
    "concept_id",
    "format",
    "ku_ids",
    "slots",
    "constraints",
    "metamorphic",
    "stem_family",
    "status",
    "author",
    "prompt_version",
    "sample_gate",
    "ext",
    "content_hash"
  ],
  "additionalProperties": false,
  "$defs": {
