{
  "type": "object",
  "properties": {
    "install_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bundled"
            },
            "track": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "alg",
                    "cs",
                    "net",
                    "lang",
                    "fe",
                    "be",
                    "db",
                    "linux",
                    "docker",
                    "k8s",
                    "cicd",
                    "sre",
                    "cloud",
                    "sec",
                    "ml",
                    "llm",
                    "arch",
                    "eng",
                    "lead",
                    "data"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["kind", "track"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user_dir"
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["kind", "dir"],
          "additionalProperties": false
        }
      ]
    },
    "channel": {
      "type": "string",
      "enum": ["seed", "local", "user"]
    },
    "allow_downgrade": {
      "type": "boolean"
    }
  },
  "required": ["install_id", "source", "channel", "allow_downgrade"],
  "additionalProperties": false
}
