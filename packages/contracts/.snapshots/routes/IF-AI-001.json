{
  "$comment": "ai-gateway.judge.run",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.judge.run"
    },
    "method": {
      "const": "POST"
    },
    "path": {
      "const": "/internal/v1/judge/{task_id}"
    },
    "allowedCallers": {
      "enum": ["content"]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "D"
    },
    "slice": {
      "const": "R1"
    },
    "fr": {
      "enum": [
        "FR-AI-004",
        "FR-AI-005",
        "FR-AI-008",
        "FR-AI-009",
        "FR-AI-017",
        "FR-AI-018",
        "FR-QST-017",
        "FR-QST-019",
        "IR-008"
      ]
    },
    "deadlineMs": {
      "const": 10000
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,20}$"
            }
          },
          "required": ["task_id"],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "template_version": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "active"
                },
                {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                }
              ]
            },
            "state": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "state_classes": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "additionalProperties": {
                "type": "string",
                "enum": ["C0", "C1", "C2", "C3"]
              }
            },
            "untrusted_keys": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              }
            },
            "questions": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "vars": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,31}$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{1,31}(\\.[a-z][a-z0-9_]{1,31}){0,3}$"
                    }
                  }
                },
                "required": ["template", "vars"],
                "additionalProperties": false
              }
            },
            "lane": {
              "type": "string",
              "enum": ["interactive", "background"]
            },
            "deadline_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            },
            "context_ref": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "attempt",
                    "dialog_turn",
                    "blank_note",
                    "item",
                    "import",
                    "pack",
                    "calibration",
                    "appeal",
                    "system"
                  ]
                },
                "phase": {
                  "type": "string",
                  "enum": ["pre_submit", "post_submit", "n_a"]
                },
                "id": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": ["kind", "phase", "id"],
              "additionalProperties": false
            },
            "calibrated_only": {
              "type": "boolean"
            },
            "family_exclude": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["anthropic", "openai", "google", "typesafe", "local", "other"]
              }
            },
            "local_only": {
              "type": "boolean"
            },
            "work_order_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "template_version",
            "state",
            "state_classes",
            "untrusted_keys",
            "questions",
            "lane",
            "deadline_ms",
            "context_ref",
            "calibrated_only",
            "family_exclude",
            "local_only",
            "work_order_id"
          ],
          "additionalProperties": false,
          "$defs": {
            "__schema0": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 20000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "ok"
                },
                "engine": {
                  "type": "string",
                  "enum": ["J", "LJ"]
                },
                "calibrated": {
                  "type": "boolean"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "answers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "noul"
                          },
                          "p_yes": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": ["type", "p_yes"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "choice"
                          },
                          "choice": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{1,31}$"
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "probabilities": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{1,31}$"
                            },
                            "additionalProperties": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        },
                        "required": ["type", "choice", "confidence", "probabilities"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "score"
                          },
                          "score": {
                            "type": "number",
                            "minimum": 0
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "probabilities": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^\\d{1,2}$"
                            },
                            "additionalProperties": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "levels": {
                            "type": "integer",
                            "minimum": 2,
                            "maximum": 10
                          }
                        },
                        "required": ["type", "score", "confidence", "probabilities", "levels"],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "model_version": {
                  "type": "string",
                  "maxLength": 80
                },
                "provider_id": {
                  "type": "string",
                  "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
                },
                "prompt_version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
                },
                "judge_log_id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "firewall_decision_id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "cache_hit": {
                  "type": "boolean"
                },
                "latency_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "status",
                "engine",
                "calibrated",
                "confidence",
                "answers",
                "model_version",
                "provider_id",
                "prompt_version",
                "judge_log_id",
                "firewall_decision_id",
                "cache_hit",
                "latency_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "offline",
                    "no_consented_provider",
                    "auth_invalid",
                    "breaker_open",
                    "deadline",
                    "firewall_blocked",
                    "budget_exhausted",
                    "quota_exhausted",
                    "task_disabled",
                    "provider_error",
                    "bad_request",
                    "calibrated_engine_unavailable",
                    "busy"
                  ]
                },
                "retry_after_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["status", "reason", "retry_after_ms"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "deferred"
                },
                "reason": {
                  "type": "string",
                  "enum": ["background_queued", "batch_window_closed", "work_order_pending"]
                },
                "job_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["status", "reason", "job_id"],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
