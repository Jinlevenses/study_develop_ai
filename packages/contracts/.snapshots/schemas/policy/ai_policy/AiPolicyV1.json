{
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "ai_policy@v1"
    },
    "budget": {
      "type": "object",
      "properties": {
        "monthly_krw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "degrade_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "warn": {
          "type": "number"
        },
        "stop": {
          "type": "number"
        },
        "per_call_usd_cap": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["monthly_krw", "degrade_day", "warn", "stop", "per_call_usd_cap"],
      "additionalProperties": false
    },
    "jev": {
      "type": "object",
      "properties": {
        "rps": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "burst": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "monthly_krw_cap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "type": "object",
          "properties": {
            "interactive": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "background": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["interactive", "background"],
          "additionalProperties": false
        }
      },
      "required": ["rps", "burst", "concurrency", "monthly_krw_cap", "timeout_ms"],
      "additionalProperties": false
    },
    "bulk": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "krw": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "quota_pct": {
          "type": "number"
        }
      },
      "required": ["calls", "krw", "quota_pct"],
      "additionalProperties": false
    },
    "quota_windows": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(claude-cli|codex-cli|gemini-cli|gcli-\\*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "five_hour_calls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "five_hour_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "weekly_calls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["five_hour_calls", "five_hour_tokens", "weekly_calls"],
        "additionalProperties": false
      }
    },
    "batch_window": {
      "type": "object",
      "properties": {
        "idle_min": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "require_ac": {
          "type": "boolean"
        }
      },
      "required": ["idle_min", "require_ac"],
      "additionalProperties": false
    },
    "yield_interactive_cli": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resume_after_min": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["enabled", "resume_after_min"],
      "additionalProperties": false
    },
    "cli_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cli_per_minute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rate_limits": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(jev|anthropic-api|openai-api|gemini-api|ollama|claude-cli|codex-cli|gemini-cli|gcli-[a-z0-9-]{2,24})$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["rpm", "concurrency"],
        "additionalProperties": false
      }
    },
    "aimd": {
      "type": "object",
      "properties": {
