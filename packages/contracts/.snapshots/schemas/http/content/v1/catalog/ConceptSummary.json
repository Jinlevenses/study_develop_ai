{
  "type": "object",
  "properties": {
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
    },
    "track": {
      "type": "string",
      "enum": [
        "alg",
        "cs",
        "net",
        "lang",
        "fe",
        "be",
        "db",
        "linux",
        "docker",
        "k8s",
        "cicd",
        "sre",
        "cloud",
        "sec",
        "ml",
        "llm",
        "arch",
        "eng",
        "lead",
        "data"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "knowledge_type": {
      "type": "string",
      "enum": [
        "D",
        "C",
        "P",
        "S"
      ]
    },
    "title_ko": {
      "type": "string",
      "maxLength": 120
    },
    "title_en": {
      "type": "string",
      "maxLength": 120
    },
    "summary_ko": {
      "type": "string",
      "maxLength": 300
    },
    "aliases": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "required_for_level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "deprecated_by": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "volatility": {
      "type": "string",
      "enum": [
        "stable",
        "evolving",
        "volatile"
      ]
    },
    "tags": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(qa|lc|ctx|stack|cert|mode):[a-z0-9_.-]{1,40}$"
      }
    }
  },
  "required": [
    "concept_id",
    "track",
    "level",
    "tier",
    "knowledge_type",
    "title_ko",
    "title_en",
    "summary_ko",
    "aliases",
    "required_for_level",
    "deprecated_by",
    "volatility",
    "tags"
  ],
  "additionalProperties": false
}
