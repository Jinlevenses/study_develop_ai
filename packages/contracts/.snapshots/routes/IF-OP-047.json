{
  "$comment": "ops.telemetry.settings",
  "type": "object",
  "properties": {
    "id": {
      "const": "ops.telemetry.settings"
    },
    "method": {
      "const": "PUT"
    },
    "path": {
      "const": "/internal/v1/telemetry/settings"
    },
    "allowedCallers": {
      "enum": [
        "gateway"
      ]
    },
    "idempotent": {
      "const": true
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R3"
    },
    "fr": {
      "enum": [
        "FR-SET-021"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "action_strength": {
              "type": "string",
              "enum": [
                "observe",
                "suggest",
                "auto_adjust"
              ]
            },
            "muted": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(TW-(0[1-9]|1[0-3])|GR-\\d{2})$"
              }
            }
          },
          "required": [
            "action_strength",
            "muted"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "action_strength": {
              "type": "string",
              "enum": [
                "observe",
                "suggest",
                "auto_adjust"
              ]
            },
            "muted": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(TW-(0[1-9]|1[0-3])|GR-\\d{2})$"
              }
            }
          },
          "required": [
            "action_strength",
            "muted"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
