{
  "type": "object",
  "properties": {
    "inbox_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "text_masked": {
      "type": "string",
      "maxLength": 8000
    },
    "masking": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "new",
        "triaged",
        "linked",
        "imported",
        "discarded"
      ]
    },
    "matches": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "concept_id",
          "score"
        ],
        "additionalProperties": false
      }
    },
    "linked_concept_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "triaged_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "inbox_id",
    "text_masked",
    "masking",
    "source_url",
    "state",
    "matches",
    "linked_concept_id",
    "created_at",
    "triaged_at"
  ],
  "additionalProperties": false
}
