{
  "type": "object",
  "properties": {
    "blueprint": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["mcq", "ox", "cloze", "short"]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "bloom": {
          "type": "string",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "target_ku_ids": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
          }
        },
        "forbidden": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "required": ["format", "level", "bloom", "count", "target_ku_ids", "forbidden"],
      "additionalProperties": false
    },
    "recent_items_digest": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "required": ["blueprint", "recent_items_digest"],
  "additionalProperties": false
}
