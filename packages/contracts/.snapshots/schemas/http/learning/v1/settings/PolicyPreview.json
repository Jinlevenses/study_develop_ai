{
  "type": "object",
  "properties": {
    "preview_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "current_policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    },
    "target_policy_version": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{16}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "report": {
      "type": "object",
      "properties": {
        "events_replayed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "queue_size_delta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mastered_delta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ldi_delta": {
          "type": ["number", "null"]
        },
        "changed_concepts": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*))$"
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "events_replayed",
        "queue_size_delta",
        "mastered_delta",
        "ldi_delta",
        "changed_concepts",
        "duration_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": ["preview_id", "current_policy_version", "target_policy_version", "expires_at", "report"],
  "additionalProperties": false
}
