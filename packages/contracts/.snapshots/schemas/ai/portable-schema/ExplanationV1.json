{
  "type": "object",
  "properties": {
    "level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "body_md": {
      "type": "string",
      "maxLength": 8000
    },
    "why_md": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "per_option": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,31}$"
          },
          "text_md": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "key",
          "text_md"
        ],
        "additionalProperties": false
      }
    },
    "cited_ku_ids": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(?:(?:u\\.[a-z0-9]+\\.[a-z0-9]+(?:-[a-z0-9]+)*|(?:alg|cs|net|lang|fe|be|db|linux|docker|k8s|cicd|sre|cloud|sec|ml|llm|arch|eng|lead|data)\\.[a-z0-9]+(?:-[a-z0-9]+)*)\\.(?:k\\d{2}|uk[0-9a-z]{26}))$"
      }
    }
  },
  "required": [
    "level",
    "body_md",
    "why_md",
    "per_option",
    "cited_ku_ids"
  ],
  "additionalProperties": false
}
