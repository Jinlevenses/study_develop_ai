{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "header"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "exporting_device_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "generated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "app_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "since_checkpoint_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "devices": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "head_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["seq", "head_hash"],
        "additionalProperties": false
      }
    },
    "schema_versions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "attempt.graded",
          "evidence.upgraded",
          "evidence.regraded",
          "evidence.voided",
          "evidence.weight_adjusted",
          "pretest.answered",
          "lesson.completed",
          "self_assessment.recorded",
          "card.enrolled",
          "card.status_changed",
          "profile.setting_changed",
          "policy.switched",
          "ai_mode.observed",
          "declaration.sealed",
          "promotion.exam_completed",
          "level.promoted",
          "level.provisional_resolved"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "required": [
        "attempt.graded",
        "evidence.upgraded",
        "evidence.regraded",
        "evidence.voided",
        "evidence.weight_adjusted",
        "pretest.answered",
        "lesson.completed",
        "self_assessment.recorded",
        "card.enrolled",
        "card.status_changed",
        "profile.setting_changed",
        "policy.switched",
        "ai_mode.observed",
        "declaration.sealed",
        "promotion.exam_completed",
        "level.promoted",
        "level.provisional_resolved"
      ]
    }
  },
  "required": [
    "kind",
    "v",
    "exporting_device_id",
    "generated_at",
    "app_version",
    "since_checkpoint_id",
    "devices",
    "schema_versions"
  ],
  "additionalProperties": false
}
