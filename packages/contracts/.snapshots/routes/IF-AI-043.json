{
  "$comment": "ai-gateway.calibration.confirm_cards",
  "type": "object",
  "properties": {
    "id": {
      "const": "ai-gateway.calibration.confirm_cards"
    },
    "method": {
      "const": "GET"
    },
    "path": {
      "const": "/internal/v1/calibration/confirm-cards"
    },
    "allowedCallers": {
      "enum": [
        "gateway"
      ]
    },
    "idempotent": {
      "const": false
    },
    "paginated": {
      "const": false
    },
    "freeze": {
      "const": "O"
    },
    "slice": {
      "const": "R2"
    },
    "fr": {
      "enum": [
        "FR-AI-013",
        "FR-AI-027"
      ]
    },
    "deadlineMs": {
      "const": null
    },
    "bodyLimitBytes": {
      "const": null
    },
    "responseKind": {
      "const": "json"
    },
    "bodyKind": {
      "const": "json"
    },
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "limit": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "200": {
          "type": "object",
          "properties": {
            "cards": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gold_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      {
                        "type": "string",
                        "pattern": "^gold\\.AI-J\\d{2}\\.\\d{3}$"
                      }
                    ]
                  },
                  "task_id": {
                    "type": "string",
                    "enum": [
                      "AI-J01",
                      "AI-J02",
                      "AI-J03",
                      "AI-J04",
                      "AI-J05",
                      "AI-J06",
                      "AI-J07",
                      "AI-J08",
                      "AI-J09",
                      "AI-J10",
                      "AI-J11",
                      "AI-J12",
                      "AI-J13",
                      "AI-J14",
                      "AI-J15",
                      "AI-J16",
                      "AI-J17",
                      "AI-J18",
                      "AI-J19"
                    ]
                  },
                  "question_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,31}$"
                  },
                  "prompt_ko": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "state_preview_md": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "model_label": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "noul"
                          },
                          "p_yes": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "type",
                          "p_yes"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "choice"
                          },
                          "choice": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{1,31}$"
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "probabilities": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{1,31}$"
                            },
                            "additionalProperties": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        },
                        "required": [
                          "type",
                          "choice",
                          "confidence",
                          "probabilities"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "score"
                          },
                          "score": {
                            "type": "number",
                            "minimum": 0
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "probabilities": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^\\d{1,2}$"
                            },
                            "additionalProperties": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "levels": {
                            "type": "integer",
                            "minimum": 2,
                            "maximum": 10
                          }
                        },
                        "required": [
                          "type",
                          "score",
                          "confidence",
                          "probabilities",
                          "levels"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "gold_id",
                  "task_id",
                  "question_key",
                  "prompt_ko",
                  "state_preview_md",
                  "model_label"
                ],
                "additionalProperties": false
              }
            },
            "remaining_today": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "cards",
            "remaining_today"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
