{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "blueprint_item"
    },
    "blueprint_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:cert-[a-z0-9]+(?:-[a-z0-9]+)*@\\d{4})$"
    },
    "section_key": {
      "type": "string",
      "pattern": "^s\\d{1,2}(_\\d{1,2})?$"
    },
    "parent_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^s\\d{1,2}(_\\d{1,2})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title_ko": {
      "type": "string",
      "maxLength": 200
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["kind", "blueprint_id", "section_key", "parent_key", "title_ko", "weight"],
  "additionalProperties": false
}
