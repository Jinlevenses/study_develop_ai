{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "source"
    },
    "source_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(?:src\\.[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },
    "source_type": {
      "type": "string",
      "enum": ["web", "doc", "book", "rfc", "paper", "repo", "user"]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "ref_text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "license_grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "P"]
    },
    "fetched_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pack\\.[a-z_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "kind",
    "source_id",
    "source_type",
    "title",
    "url",
    "ref_text",
    "license_grade",
    "fetched_at",
    "ext",
    "content_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
